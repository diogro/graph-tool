@article{virkar_power-law_2012,
  title = {Power-Law Distributions in Binned Empirical Data},
  author = {Virkar, Yogesh and Clauset, Aaron},
  year = 2012,
  month = aug,
  journal = {arXiv:1208.3524},
  eprint = {1208.3524},
  url = {http://arxiv.org/abs/1208.3524},
  urldate = {2013-01-18},
  abstract = {Many man-made and natural phenomena, including the intensity of earthquakes, population of cities, and size of international wars, are believed to follow power-law distributions. The accurate identification of power-law patterns has significant consequences for developing an understanding of complex systems. However, statistical evidence for or against the power-law hypothesis is complicated by large fluctuations in the empirical distribution's tail, and these are worsened when information is lost from binning the data. We adapt the statistically principled framework for testing the power-law hypothesis, developed by Clauset, Shalizi and Newman, to the case of binned data. This approach includes maximum-likelihood fitting, a hypothesis test based on the Kolmogorov-Smirnov goodness-of-fit statistic and likelihood ratio tests for comparing against alternative explanations. We evaluate the effectiveness of these methods on synthetic binned data with known structure and apply them to twelve real-world binned data sets with heavy-tailed patterns.},
  archiveprefix = {arXiv},
  keywords = {Physics - Data Analysis Statistics and Probability,Physics - Physics and Society,Statistics - Applications,Statistics - Methodology},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/JZXRE5UT/Virkar and Clauset - 2012 - Power-law distributions in binned empirical data.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/8G5QNURD/1208.html}
}

@misc{vishwanathan_modularity_2020,
  title = {Modularity and Neural Coding from a Brainstem Synaptic Wiring Diagram},
  author = {Vishwanathan, Ashwin and Ramirez, Alexandro D. and Wu, Jingpeng and Sood, Alex and Yang, Runzhe and Kemnitz, Nico and Ih, Dodam and Turner, Nicholas and Lee, Kisuk and Tartavull, Ignacio and Silversmith, William M. and Jordan, Chris S. and David, Celia and Bland, Doug and Goldman, Mark S. and Aksay, Emre R. F. and Seung, H. Sebastian and EyeWirers, The},
  year = 2020,
  month = oct,
  primaryclass = {New Results},
  pages = {2020.10.28.359620},
  publisher = {bioRxiv},
  doi = {10.1101/2020.10.28.359620},
  url = {https://www.biorxiv.org/content/10.1101/2020.10.28.359620v1},
  urldate = {2022-10-03},
  abstract = {Neuronal wiring diagrams reconstructed from electron microscopic images are enabling new ways of attacking neuroscience questions. We address two central issues, modularity and neural coding, by reconstructing and analyzing a wiring diagram from a larval zebrafish brainstem. We identified a recurrently connected ``center'' within the 3000-node graph, and applied graph clustering algorithms to divide the center into two modules with stronger connectivity within than between modules. Outgoing connection patterns and registration to maps of neural activity suggested the modules were specialized for body and eye movements. The eye movement module further subdivided into two submodules corresponding to the control of the two eyes. We constructed a recurrent network model of the eye movement module with connection strengths estimated from synapse numbers. Neural activity in the model replicated the statistics of eye position encoding across multiple populations of neurons as observed by calcium imaging. Our findings show that synapse-level wiring diagrams can be used to extract structural modules with interpretable functions in the vertebrate brain, and can be related to the encoding of computational variables important for behavior. We also show through a potential synapse formalism that these modeling successes require true synaptic connectivity; connectivity inferred from arbor overlap is insufficient.},
  archiveprefix = {bioRxiv},
  chapter = {New Results},
  copyright = {\copyright{} 2020, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution-NoDerivs 4.0 International), CC BY-ND 4.0, as described at http://creativecommons.org/licenses/by-nd/4.0/},
  langid = {english},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/3KBFF7MH/Vishwanathan et al. - 2020 - Modularity and neural coding from a brainstem syna.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/6G64XAFR/2020.10.28.359620v1.html}
}

@misc{vishwanathan_predicting_2022,
  title = {Predicting Modular Functions and Neural Coding of Behavior from a Synaptic Wiring Diagram},
  author = {Vishwanathan, Ashwin and Ramirez, Alexandro D. and Wu, Jingpeng and Sood, Alex and Yang, Runzhe and Kemnitz, Nico and Ih, Dodam and Turner, Nicholas and Lee, Kisuk and Tartavull, Ignacio and Silversmith, William M. and Jordan, Chris S. and David, Celia and Bland, Doug and Goldman, Mark S. and Aksay, Emre R. F. and Seung, H. Sebastian and Eyewirers, The},
