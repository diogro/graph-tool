@article{neeman_non-reconstructability_2014,
  title = {Non-{{Reconstructability}} in the {{Stochastic Block Model}}},
  author = {Neeman, Joe and Netrapalli, Praneeth},
  year = 2014,
  month = apr,
  journal = {arXiv:1404.6304 [cs, math]},
  eprint = {1404.6304},
  primaryclass = {cs, math},
  url = {http://arxiv.org/abs/1404.6304},
  urldate = {2014-10-14},
  abstract = {We consider the problem of clustering (or reconstruction) in the stochastic block model, in the regime where the average degree is constant. For the case of two clusters with equal sizes, recent results by Mossel, Neeman and Sly, and by Massoulie, show that reconstructability undergoes a phase transition at the Kesten-Stigum bound of \$\textbackslash lambda\_2\textasciicircum 2 d = 1\$, where \$\textbackslash lambda\_2\$ is the second largest eigenvalue of a related stochastic matrix and \$d\$ is the average degree. In this paper, we address the general case of more than two clusters and/or unbalanced cluster sizes. Our main result is a sufficient condition for clustering to be impossible, which matches the existing result for two clusters of equal sizes. A key ingredient in our result is a new connection between non-reconstructability and non-distinguishability of the block model from an Erd\textbackslash H\textbraceleft o\textbraceright s-R\textbackslash 'enyi model with the same average degree. We also show that it is some times possible to reconstruct even when \$\textbackslash lambda\_2\textasciicircum 2 d {$<$} 1\$. Our results provide evidence supporting a series of conjectures made by Decelle, Krzkala, Moore and Zdeborov\textbackslash 'a regarding reconstructability and distinguishability of stochastic block models (but do not settle them).},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Mathematics - Probability},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/7DFEWK7J/Neeman and Netrapalli - 2014 - Non-Reconstructability in the Stochastic Block Mod.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/8RQ6SJB4/1404.html}
}

@article{negahban_rank_2017,
  title = {Rank {{Centrality}}: {{Ranking}} from {{Pairwise Comparisons}}},
  shorttitle = {Rank {{Centrality}}},
  author = {Negahban, Sahand and Oh, Sewoong and Shah, Devavrat},
  year = 2017,
  month = feb,
  journal = {Operations Research},
  volume = {65},
  number = {1},
  pages = {266--287},
  publisher = {INFORMS},
  issn = {0030-364X},
  doi = {10.1287/opre.2016.1534},
  url = {https://pubsonline.informs.org/doi/abs/10.1287/opre.2016.1534},
  urldate = {2022-03-25},
  abstract = {The question of aggregating pairwise comparisons to obtain a global ranking over a collection of objects has been of interest for a very long time: be it ranking of online gamers (e.g., MSR's TrueSkill system) and chess players, aggregating social opinions, or deciding which product to sell based on transactions. In most settings, in addition to obtaining a ranking, finding `scores' for each object (e.g., player's rating) is of interest for understanding the intensity of the preferences. In this paper, we propose RankCentrality, an iterative rank aggregation algorithm for discovering scores for objects (or items) from pairwise comparisons. The algorithm has a natural random walk interpretation over the graph of objects with an edge present between a pair of objects if they are compared; the score, which we call Rank Centrality, of an object turns out to be its stationary probability under this random walk. To study the efficacy of the algorithm, we consider the popular Bradley-Terry-Luce (BTL) model (equivalent to the Multinomial Logit (MNL) for pairwise comparisons) in which each object has an associated score that determines the probabilistic outcomes of pairwise comparisons between objects. In terms of the pairwise marginal probabilities, which is the main subject of this paper, the MNL model and the BTL model are identical. We bound the finite sample error rates between the scores assumed by the BTL model and those estimated by our algorithm. In particular, the number of samples required to learn the score well with high probability depends on the structure of the comparison graph. When the Laplacian of the comparison graph has a strictly positive spectral gap, e.g., each item is compared to a subset of randomly chosen items, this leads to dependence on the number of samples that is nearly order optimal. Experimental evaluations on synthetic data sets generated according to the BTL model show that our algorithm performs as well as the maximum likelihood estimator for that model and outperforms other popular ranking algorithms.},
  keywords = {Markov chain,random walk,rank aggregation,rank centrality},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/CXDRKSMA/Negahban et al. - 2017 - Rank Centrality Ranking from Pairwise Comparisons.pdf}
}

