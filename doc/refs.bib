@inproceedings{aiello_link_2010,
  title = {Link {{Creation}} and {{Profile Alignment}} in the {{aNobii Social Network}}},
  booktitle = {2010 {{IEEE Second International Conference}} on {{Social Computing}} ({{SocialCom}})},
  author = {Aiello, Luca Maria and Barrat, Alain and Cattuto, Ciro and Ruffo, Giancarlo and Schifanella, Rossano},
