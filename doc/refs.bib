}

@article{schneider_mitigation_2011,
  title = {Mitigation of Malicious Attacks on Networks},
  author = {Schneider, Christian M. and Moreira, Andr{\'e} A. and Andrade, Jos{\'e} S. and Havlin, Shlomo and Herrmann, Hans J.},
  year = 2011,
  month = mar,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {108},
  number = {10},
  pages = {3838--3841},
  doi = {10.1073/pnas.1009440108},
  url = {http://www.pnas.org/content/108/10/3838.abstract},
  urldate = {2011-12-30},
  abstract = {Terrorist attacks on transportation networks have traumatized modern societies. With a single blast, it has become possible to paralyze airline traffic, electric power supply, ground transportation or Internet communication. How and at which cost can one restructure the network such that it will become more robust against a malicious attack? We introduce a new measure for robustness and use it to devise a method to mitigate economically and efficiently this risk. We demonstrate its efficiency on the European electricity system and on the Internet as well as on complex networks models. We show that with small changes in the network structure (low cost) the robustness of diverse networks can be improved dramatically whereas their functionality remains unchanged. Our results are useful not only for improving significantly with low cost the robustness of existing infrastructures but also for designing economically robust network systems.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/46GWAXWR/PNAS-2011-Schneider-3838-41.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/TZIR4THW/PNAS-2011-Schneider-3838-41.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/6GQVA7SU/3838.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/6UQWWCIJ/3838.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/FWIZRH7C/3838.full.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/T855SSDK/3838.full.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/UANUZKCZ/3838.full.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/X6XUD7HR/3838.full.html}
}

@article{schneider_suppressing_2011,
  title = {Suppressing Epidemics with a Limited Amount of Immunization Units},
  author = {Schneider, Christian M. and Mihaljev, Tamara and Havlin, Shlomo and Herrmann, Hans J.},
  year = 2011,
  month = dec,
  journal = {Physical Review E},
  volume = {84},
  number = {6},
  pages = {061911},
  doi = {10.1103/PhysRevE.84.061911},
  url = {http://link.aps.org/doi/10.1103/PhysRevE.84.061911},
  urldate = {2012-05-09},
  abstract = {The way diseases spread through schools, epidemics through countries, and viruses through the internet is crucial in determining their risk. Although each of these threats has its own characteristics, its underlying network determines the spreading. To restrain the spreading, a widely used approach is the fragmentation of these networks through immunization, so that epidemics cannot spread. Here we develop an immunization approach based on optimizing the susceptible size, which outperforms the best known strategy based on immunizing the highest-betweenness links or nodes. We find that the network's vulnerability can be significantly reduced, demonstrating this on three different real networks: the global flight network, a school friendship network, and the internet. In all cases, we find that not only is the average infection probability significantly suppressed, but also for the most relevant case of a small and limited number of immunization units the infection probability can be reduced by up to 55\%.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/3SDVQRR3/Schneider et al. - 2011 - Suppressing epidemics with a limited amount of imm.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/B5F48A34/e061911.html}
}

@article{schneider_towards_2011,
  title = {Towards Designing Robust Coupled Networks},
  author = {Schneider, Christian M and Araujo, Nuno A. M and Havlin, Shlomo and Herrmann, Hans J},
  year = 2011,
  month = jun,
  journal = {arXiv:1106.3234},
  eprint = {1106.3234},
  url = {http://arxiv.org/abs/1106.3234},
  urldate = {2012-02-03},
  abstract = {In nature and technology, network-like systems are typically coupled and the resilience of one is affected by the others. The failure of a small fraction of elements in the system may have catastrophic effects, by triggering a cascade of events which drastically affects the global connectivity. We show that by choosing the proper autonomous nodes, catastrophic cascading failures can be avoided. We reveal that, when a small optimal fraction of autonomous nodes (about 10\%) is properly selected the nature of the percolation transition changes from discontinuous to continuous and the robustness of the system is significantly improved. This is in contrast to random selection where close to 50\% of autonomous nodes are needed. Surprisingly, even for coupled Poissonian type networks, where the variety between the node degrees is small, the proper choice of autonomous nodes leads to a large improvement.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Disordered Systems and Neural Networks,Condensed Matter - Statistical Mechanics,Physics - Computational Physics,Physics - Data Analysis Statistics and Probability},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/XGENUZIJ/Schneider et al. - 2011 - Towards designing robust coupled networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9S222TH4/1106.html}
}

@article{schneidman_weak_2006,
  title = {Weak Pairwise Correlations Imply Strongly Correlated Network States in a Neural Population},
  author = {Schneidman, Elad and Berry, Michael J. and Segev, Ronen and Bialek, William},
  year = 2006,
  month = apr,
  journal = {Nature},
  volume = {440},
  number = {7087},
  pages = {1007--1012},
  issn = {0028-0836},
  doi = {10.1038/nature04701},
  url = {http://www.nature.com/nature/journal/v440/n7087/full/nature04701.html},
  urldate = {2015-01-19},
  abstract = {Biological networks have so many possible states that exhaustive sampling is impossible. Successful analysis thus depends on simplifying hypotheses, but experiments on many systems hint that complicated, higher-order interactions among large groups of elements have an important role. Here we show, in the vertebrate retina, that weak correlations between pairs of neurons coexist with strongly collective behaviour in the responses of ten or more neurons. We find that this collective behaviour is described quantitatively by models that capture the observed pairwise correlations but assume no higher-order interactions. These maximum entropy models are equivalent to Ising models, and predict that larger networks are completely dominated by correlation effects. This suggests that the neural code has associative or error-correcting properties, and we provide preliminary evidence for such behaviour. As a first test for the generality of these ideas, we show that similar results are obtained from networks of cultured cortical neurons.},
  copyright = {\copyright{} 2006 Nature Publishing Group},
  langid = {english},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/IIFJ96CJ/Schneidman et al. - 2006 - Weak pairwise correlations imply strongly correlat.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/C7VTSQQ4/nature04701.html}
}

