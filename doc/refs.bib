@article{battiston_statistical_2004,
  title = {Statistical Properties of Corporate Board and Director Networks},
  author = {Battiston, S. and Catanzaro, M.},
  year = 2004,
  month = mar,
  journal = {The European Physical Journal B - Condensed Matter and Complex Systems},
  volume = {38},
  number = {2},
  pages = {345--352},
  issn = {1434-6028, 1434-6036},
  doi = {10.1140/epjb/e2004-00127-8},
  url = {http://link.springer.com/article/10.1140/epjb/e2004-00127-8},
  urldate = {2013-03-26},
  abstract = {The boards of directors of the largest corporations of a country together with the directors form a dense bipartite network. The board network consists of boards connected through common directors. The director network is obtained taking the directors as nodes, and a membership in the same board as a link. These networks are involved in the decision making processes relevant to the macro-economy of a country. We present an extensive and comparative analysis of the statistical properties of the board network and the director network for the first 1000 US corporations ranked by revenue (``Fortune 1000'') in the year 1999 and for the corporations of the Italian Stock Market. We find several common statistical properties across the data sets, despite the fact that they refer to different years and countries. This suggests an underlying universal formation mechanism which is not captured in a satisfactory way by the existent network models. In particular we find that all the considered networks are Small Worlds, assortative, highly clustered and dominated by a giant component. Several other properties are examined. The presence of a lobby in a board, a feature relevant to decision making dynamics, turns out to be a macroscopic phenomenon in all the data sets.},
  langid = {english},
  lccn = {0069},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/Q6X4ZHZA/Battiston and Catanzaro - 2004 - Statistical properties of corporate board and dire.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/2SZIEXSR/10.html}
}

