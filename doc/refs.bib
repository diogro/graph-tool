  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/XDCA956Z/Peixoto - 2022 - Ordered community detection in directed networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/JAFT33ZT/PhysRevE.106.html}
