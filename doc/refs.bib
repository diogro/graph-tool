  pmid = {16899655},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/3JVP8DU6/Flannick et al. - 2006 - Græmlin General and robust alignment of multiple .pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/VRI7BSUR/1169.html}
