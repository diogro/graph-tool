@article{bianconi_assessing_2009,
  title = {Assessing the Relevance of Node Features for Network Structure},
  author = {Bianconi, Ginestra and Pin, Paolo and Marsili, Matteo},
  year = 2009,
  month = jul,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {106},
  number = {28},
  pages = {11433--11438},
  doi = {10.1073/pnas.0811511106},
  url = {http://www.pnas.org/content/106/28/11433.abstract},
  urldate = {2011-11-10},
  abstract = {Networks describe a variety of interacting complex systems in social science, biology, and information technology. Usually the nodes of real networks are identified not only by their connections but also by some other characteristics. Examples of characteristics of nodes can be age, gender, or nationality of a person in a social network, the abundance of proteins in the cell taking part in protein-interaction networks, or the geographical position of airports that are connected by directed flights. Integrating the information on the connections of each node with the information about its characteristics is crucial to discriminating between the essential and negligible characteristics of nodes for the structure of the network. In this paper we propose a general indicator {$\Theta$}, based on entropy measures, to quantify the dependence of a network's structure on a given set of features. We apply this method to social networks of friendships in U.S. schools, to the protein-interaction network of Saccharomyces cerevisiae and to the U.S. airport network, showing that the proposed measure provides information that complements other known measures.},
  keywords = {Communities,Entropy,inference,social networks},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/4K4VPTV5/Bianconi et al. - 2009 - Assessing the relevance of node features for netwo.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9C5TWG3K/Bianconi et al. - 2009 - Assessing the relevance of node features for netwo.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/IUWBHGF6/PNAS-2009-Bianconi-11433-8.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/7XFK24ZZ/11433.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/B6D4PRVF/11433.html}
