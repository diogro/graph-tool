  url = {http://arxiv.org/abs/0908.0146},
  urldate = {2009-09-02},
  abstract = {In the postgenome era many efforts have been dedicated to systematically elucidate the complex web of interacting genes and proteins. These efforts include experimental and computational methods. Microarray technology offers an opportunity for monitoring gene expression level at the genome scale. By recourse to information theory, this study proposes a mathematical approach to reconstruct gene regulatory networks at coarse-grain level from high throughput gene expression data. The method provides the \textbraceleft\textbackslash it a posteriori\textbraceright{} probability that a given gene regulates positively, negatively or does not regulate each one of the network genes. This approach also allows the introduction of prior knowledge and the quantification of the information gain from experimental data used in the inference procedure. This information gain can be used to chose genes to be perturbed in subsequent experiments in order to refine the knowledge about the architecture of an underlying gene regulatory network. The performance of the proposed approach has been studied by \textbraceleft\textbackslash it in numero\textbraceright{} experiments. Our results suggest that the approach is suitable for focusing on size-limited problems, such as, recovering a small subnetwork of interest by performing perturbation over selected genes.},
  archiveprefix = {arXiv},
  keywords = {Quantitative Biology - Molecular Networks,Quantitative Biology - Quantitative Methods},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/W852QZ4Z/Diambra - 2009 - Inferring genetic networks An information theoret.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/TT5KKTE7/0908.html}
}

