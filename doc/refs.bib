@article{lubeck_universal_2005,
  title = {Universal Scaling Behavior of Non-Equilibrium Phase Transitions},
  author = {Lubeck, S.},
  year = 2005,
  month = jan,
  journal = {cond-mat/0501259},
  eprint = {cond-mat/0501259},
  doi = {doi:10.1142/S0217979204027748},
  url = {http://arxiv.org/abs/cond-mat/0501259},
  urldate = {2010-05-07},
  abstract = {One of the most impressive features of continuous phase transitions is the concept of universality, that allows to group the great variety of different critical phenomena into a small number of universality classes. All systems belonging to a given universality class have the same critical exponents, and certain scaling functions become identical near the critical point. It is the aim of this work to demonstrate the usefulness of universal scaling functions for the analysis of non-equilibrium phase transitions. In order to limit the coverage of this article, we focus on a particular class of non-equilibrium critical phenomena, the so-called absorbing phase transitions. These phase transitions arise from a competition of opposing processes, usually creation and annihilation processes. The transition point separates an active phase and an absorbing phase in which the dynamics is frozen. A systematic analysis of universal scaling functions of absorbing phase transitions is presented, including static, dynamical, and finite-size scaling measurements. As a result a picture gallery of universal scaling functions is presented which allows to identify and to distinguish universality classes.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Statistical Mechanics},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/SSEXUN8X/Lubeck - 2005 - Universal scaling behavior of non-equilibrium phas.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/458T3C52/0501259.html}
