  langid = {english},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/WG6S8DC6/Gerlach et al. - 2018 - A network approach to topic models.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/IWJ5IV2C/eaaq1360.html}
