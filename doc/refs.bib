@article{sienkiewicz_external_2010,
  title = {External Bias in the Model of Isolation of Communities},
  author = {Sienkiewicz, Julian and Siudem, Grzegorz and Holstrokyst, Janusz A.},
  year = 2010,
  month = nov,
  journal = {Physical Review E},
  volume = {82},
