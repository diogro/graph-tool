@article{chen_community_2014,
  title = {Community {{Detection}} via {{Maximization}} of {{Modularity}} and {{Its Variants}}},
  author = {Chen, Mingming and Kuzmin, Konstantin and Szymanski, Boleslaw K.},
  year = 2014,
  month = mar,
  journal = {IEEE Transactions on Computational Social Systems},
  volume = {1},
  number = {1},
  pages = {46--65},
  issn = {2329-924X},
  doi = {10.1109/TCSS.2014.2307458},
  abstract = {In this paper, we first discuss the definition of modularity (Q) used as a metric for community quality and then we review the modularity maximization approaches which were used for community detection in the last decade. Then, we discuss two opposite yet coexisting problems of modularity optimization; in some cases, it tends to favor small communities over large ones while in others, large communities over small ones (so-called the resolution limit problem). Next, we overview several community quality metrics proposed to solve the resolution limit problem and discuss Modularity Density (Qds ), which simultaneously avoids the two problems of modularity. Finally, we introduce two novel fine-tuned community detection algorithms that iteratively attempt to improve the community quality measurements by splitting and merging the given network community structure. The first one, referred to as Fine-tuned , is based on modularity (Q), while the second is based on Modularity Density (Qds ) and denoted as Fine-tuned . Then, we compare the greedy algorithm of modularity maximization (denoted as Greedy ), Fine-tuned , and Fine-tuned on four real networks, and also on the classical clique network and the LFR benchmark networks, each of which is instantiated by a wide range of parameters. The results indicate that Fine-tuned Qds is the most effective among the three algorithms discussed. Moreover, we show that Fine-tuned Qds can be applied to the communities detected by other algorithms to significantly improve their results.},
  keywords = {Clustering algorithms,Communities,Community detection,Eigenvalues and eigenfunctions,fine-tuned,maximization,Merging,modularity,Optimization,Partitioning algorithms,Vectors},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/XYPDNXB6/Chen et al. - 2014 - Community Detection via Maximization of Modularity.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/5AGNWAV2/6785984.html}
}

