@article{ribeiro_stochastic_2010,
  title = {Stochastic and Delayed Stochastic Models of Gene Expression and Regulation},
  author = {Ribeiro, Andre S.},
  year = 2010,
  month = jan,
  journal = {Mathematical Biosciences},
  volume = {223},
  number = {1},
