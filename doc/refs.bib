  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/6NU7JAD3/Zhang et al. - 2021 - Quadratic sparse Gaussian graphical model estimati.pdf}
}

@article{zhang_random_2016,
  title = {Random Graph Models for Dynamic Networks},
  author = {Zhang, Xiao and Moore, Cristopher and Newman, M. E. J.},
