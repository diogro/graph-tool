  author = {Guseva, Ksenia and Feudel, Ulrike and T{\'e}l, Tam{\'a}s},
  year = 2013,
  month = oct,
  journal = {Physical Review E},
  volume = {88},
  number = {4},
  pages = {042909},
  doi = {10.1103/PhysRevE.88.042909},
  url = {http://link.aps.org/doi/10.1103/PhysRevE.88.042909},
  urldate = {2016-09-25},
  abstract = {We analyze the effect of the Basset history force on the sedimentation or rising of inertial particles in a two-dimensional convection flow. When memory effects are neglected, the system exhibits rich dynamics, including periodic, quasiperiodic, and chaotic attractors. Here we show that when the full advection dynamics is considered, including the history force, both the nature and the number of attractors change, and a fractalization of their basins of attraction appears. In particular, we show that the history force significantly weakens the horizontal diffusion and changes the speed of sedimentation or rising. The influence of the history force is dependent on the size of the advected particles, being stronger for larger particles.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/R3BI7ZIS/Guseva et al. - 2013 - Influence of the history force on inertial particl.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/6MTJSXEQ/PhysRevE.88.html}
}

