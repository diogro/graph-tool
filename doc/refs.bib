  archiveprefix = {arXiv},
  keywords = {65K05 90C06 90C25 90C90,Computer Science - Machine Learning,Mathematics - Numerical Analysis,Mathematics - Optimization and Control,Statistics - Computation,Statistics - Machine Learning},
