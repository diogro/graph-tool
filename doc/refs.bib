  lccn = {0000},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/7VCE6TFH/PhysRevLett.110.148701.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/QEHEADHE/e148701.html}
}

@article{peixoto_reconstructing_2018,
  title = {Reconstructing {{Networks}} with {{Unknown}} and {{Heterogeneous Errors}}},
  author = {Peixoto, Tiago P.},
