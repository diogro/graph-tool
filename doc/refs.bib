@article{batagelj_fast_2011,
  title = {Fast Algorithms for Determining (Generalized) Core Groups in Social Networks},
  author = {Batagelj, Vladimir and Zaver{\v s}nik, Matja{\v z}},
  year = 2011,
  month = jul,
  journal = {Advances in Data Analysis and Classification},
  volume = {5},
  number = {2},
  pages = {129--145},
  issn = {1862-5347, 1862-5355},
  doi = {10.1007/s11634-010-0079-y},
  url = {http://link.springer.com/article/10.1007/s11634-010-0079-y},
  urldate = {2013-11-26},
  abstract = {The structure of a large network (graph) can often be revealed by partitioning it into smaller and possibly more dense sub-networks that are easier to handle. One of such decompositions is based on ``k-cores'', proposed in 1983 by Seidman. Together with connectivity components, cores are one among few concepts that provide efficient decompositions of large graphs and networks. In this paper we propose an efficient algorithm for determining the cores decomposition of a given network with complexity (m)\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright (m)\textbraceright{} , where m is the number of lines (edges or arcs). In the second part of the paper the classical concept of k-core is generalized in a way that uses a vertex property function instead of degree of a vertex. For local monotone vertex property functions the corresponding generalized cores can be determined in (m{$\cdot$}max({$\Delta$},logn))\textbraceleft\textbackslash mathcal\textbraceleft O\textbraceright (m\textbackslash cdot\textbackslash max(\textbackslash Delta,\textbackslash log\textbraceleft n\textbraceright ))\textbraceright{} time, where n is the number of vertices and {$\Delta$} is the maximum degree. Finally the proposed algorithms are illustrated by the analysis of a collaboration network in the field of computational geometry.},
  langid = {english},
  keywords = {05A18,05C70,05C85,05C90,68R10,68W40,92G30,92H30,93A15,Core,Decomposition,Graph algorithm,Large network,Statistical Theory and Methods,Statistics for Business/Economics/Mathematical Finance/Insurance,Statistics for Engineering Physics Computer Science Chemistry and Earth Sciences,Statistics for Life Sciences Medicine Health Sciences,Statistics for Social Science Behavorial Science Education Public Policy and Law},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/2QCGXD2W/10.html}
