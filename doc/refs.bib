@article{grechnikov_degree_2011,
  title = {The Degree Distribution and the Number of Edges between Nodes of given Degrees in the {{Buckley-Osthus}} Model of a Random Web Graph},
  author = {Grechnikov, Evgeniy A},
  year = 2011,
  month = aug,
  journal = {1108.4054},
  eprint = {1108.4054},
  url = {http://arxiv.org/abs/1108.4054},
  urldate = {2011-08-23},
  abstract = {In this paper, we study some important statistics of the random graph in the Buckley-Osthus model. This model is a modification of the well-known Bollob\textbackslash 'as-Riordan model. We denote the number of nodes by t, the so-called initial attractiveness of a node by a. First, we find a new asymptotic formula for the expectation of the number R(d,t) of nodes of a given degree d in a graph in this model. Such a formula is known for positive integer values of a and d \textbackslash le t\textasciicircum\textbraceleft 1/100(a+1)\textbraceright. Both restrictions are unsatisfactory from theoretical and practical points of view. We completely remove them. Then we calculate the covariances between any two quantities R(d\_1,t), R(d\_2,t), and using the second moment method we show that R(d,t) is tightly concentrated around its mean for every possible values of d and t. Furthermore, we study a more complicated statistic of the web graph: X(d\_1,d\_2,t) is the total number of edges between nodes whose degrees are equal to d\_1 and d\_2 respectively. We also find an asymptotic formula for the expectation of X(d\_1,d\_2,t) and prove a tight concentration result. Again, we do not impose any substantial restrictions on the values of d\_1, d\_2, and t.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Combinatorics,Mathematics - Probability},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/3QSVKA2Z/Grechnikov - 2011 - The degree distribution and the number of edges be.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/DRT5HARV/1108.html}
}

