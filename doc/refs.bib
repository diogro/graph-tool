  doi = {10.48550/arXiv.0905.2639},
  url = {http://arxiv.org/abs/0905.2639},
  urldate = {2023-09-24},
  abstract = {The problem of graphical model selection is to correctly estimate the graph structure of a Markov random field given samples from the underlying distribution. We analyze the information-theoretic limitations of the problem of graph selection for binary Markov random fields under high-dimensional scaling, in which the graph size \$p\$ and the number of edges \$k\$, and/or the maximal node degree \$d\$ are allowed to increase to infinity as a function of the sample size \$n\$. For pairwise binary Markov random fields, we derive both necessary and sufficient conditions for correct graph selection over the class \$\textbackslash mathcal\textbraceleft G\textbraceright\_\textbraceleft p,k\textbraceright\$ of graphs on \$p\$ vertices with at most \$k\$ edges, and over the class \$\textbackslash mathcal\textbraceleft G\textbraceright\_\textbraceleft p,d\textbraceright\$ of graphs on \$p\$ vertices with maximum degree at most \$d\$. For the class \$\textbackslash mathcal\textbraceleft G\textbraceright\_\textbraceleft p, k\textbraceright\$, we establish the existence of constants \$c\$ and \$c'\$ such that if \$\textbackslash numobs {$<$} c k \textbackslash log p\$, any method has error probability at least 1/2 uniformly over the family, and we demonstrate a graph decoder that succeeds with high probability uniformly over the family for sample sizes \$\textbackslash numobs {$>$} c' k\textasciicircum 2 \textbackslash log p\$. Similarly, for the class \$\textbackslash mathcal\textbraceleft G\textbraceright\_\textbraceleft p,d\textbraceright\$, we exhibit constants \$c\$ and \$c'\$ such that for \$n {$<$} c d\textasciicircum 2 \textbackslash log p\$, any method fails with probability at least 1/2, and we demonstrate a graph decoder that succeeds with high probability for \$n {$>$} c' d\textasciicircum 3 \textbackslash log p\$.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Information Theory,Computer Science - Machine Learning,Mathematics - Statistics Theory},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/QP99JSCA/Santhanam und Wainwright - 2009 - Information-theoretic limits of selecting binary g.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/WMEM92UP/0905.html}
}

