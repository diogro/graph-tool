  abstract = {The article is a creative compilation of certain papers devoted to the graph isomorphism problem, which have appeared in recent years. An approach to the isomorphism problem is proposed in the first chapter, combining, mainly, the works of Babai and Luks. This approach, being to the survey's authors the most promising and fruitful of results, has two characteristic features: the use of information on the special structure of the automorphism group and the profound application of the theory of permutation groups. In particular, proofs are given of the recognizability of the isomorphism of graphs with bounded valences in polynomial time and of all graphs in moderately exponential time. In the second chapter a free exposition is given of the Filotti-Mayer-Miller results on the isomorphism of graphs of bounded genus. New and more complete proofs of the main assertions are presented, as well as an algorithm for the testing of the isomorphism of graphs of genus g in time O(vO(g)), where v is the number of vertices. In the third chapter certain extended means of the construction of algorithms testing an isomorphism are discussed together with probabilistically estimated algorithms and the Las Vegas algorithms. In the fourth chapter the connections of the graph isomorphism problem with other problems are examined.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/T9T7PKRH/Zemlyachenko et al. - 1985 - Graph isomorphism problem.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/J3CPWUBZ/t88l336817148836.html}
}

@article{zeng_enhancing_2012,
  title = {Enhancing Network Robustness for Malicious Attacks},
  author = {Zeng, An and Liu, Weiping},
  year = 2012,
  month = mar,
  journal = {arXiv:1203.2982},
  eprint = {1203.2982},
  url = {http://arxiv.org/abs/1203.2982},
  urldate = {2012-05-02},
  abstract = {In a recent work [Proc. Natl. Acad. Sci. USA 108, 3838 (2011)], the authors proposed a simple measure for network robustness under malicious attacks on nodes. With a greedy algorithm, they found the optimal structure with respect to this quantity is an onion structure in which high-degree nodes form a core surrounded by rings of nodes with decreasing degree. However, in real networks the failure can also occur in links such as dysfunctional power cables and blocked airlines. Accordingly, complementary to the node-robustness measurement (\$R\_\textbraceleft n\textbraceright\$), we propose a link-robustness index (\$R\_\textbraceleft l\textbraceright\$). We show that solely enhancing \$R\_\textbraceleft n\textbraceright\$ cannot guarantee the improvement of \$R\_\textbraceleft l\textbraceright\$. Moreover, the structure of \$R\_\textbraceleft l\textbraceright\$-optimized network is found to be entirely different from that of onion network. In order to design robust networks resistant to more realistic attack condition, we propose a hybrid greedy algorithm which takes both the \$R\_\textbraceleft n\textbraceright\$ and \$R\_\textbraceleft l\textbraceright\$ into account. We validate the robustness of our generated networks against malicious attacks mixed with both nodes and links failure. Finally, some economical constraints for swapping the links in real networks are considered and significant improvement in both aspects of robustness are still achieved.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Physics - Computational Physics,Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/QZM6AW7Q/Zeng and Liu - 2012 - Enhancing network robustness for malicious attacks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/C4DE8RKK/Zeng and Liu - 2012 - Enhancing network robustness for malicious attacks.html}
}

@article{zeng_maximum_2013,
  title = {Maximum {{Likelihood Reconstruction}} for {{Ising Models}} with {{Asynchronous Updates}}},
  author = {Zeng, Hong-Li and Alava, Mikko and Aurell, Erik and Hertz, John and Roudi, Yasser},
  year = 2013,
  month = may,
  journal = {Physical Review Letters},
  volume = {110},
  number = {21},
  pages = {210601},
  doi = {10.1103/PhysRevLett.110.210601},
  url = {http://link.aps.org/doi/10.1103/PhysRevLett.110.210601},
  urldate = {2014-11-19},
  abstract = {We describe how the couplings in an asynchronous kinetic Ising model can be inferred. We consider two cases: one in which we know both the spin history and the update times and one in which we know only the spin history. For the first case, we show that one can average over all possible choices of update times to obtain a learning rule that depends only on spin correlations and can also be derived from the equations of motion for the correlations. For the second case, the same rule can be derived within a further decoupling approximation. We study all methods numerically for fully asymmetric Sherrington-Kirkpatrick models, varying the data length, system size, temperature, and external field. Good convergence is observed in accordance with the theoretical expectations.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/WRSQ35CJ/Zeng et al. - 2013 - Maximum Likelihood Reconstruction for Ising Models.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/S7NAG3H2/PhysRevLett.110.html}
}

