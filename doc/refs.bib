@article{giuffrida_testing_2026,
  title = {Testing Maximum Entropy Models with \$e\$-Values},
  author = {Giuffrida, Francesca and Garlaschelli, Diego and Gr{\"u}nwald, Peter},
  year = 2026,
  month = may,
  journal = {Physical Review E},
  volume = {113},
  number = {5},
  pages = {054306},
  publisher = {American Physical Society},
  doi = {10.1103/xhf5-1l7p},
  url = {https://link.aps.org/doi/10.1103/xhf5-1l7p},
  urldate = {2026-10-02},
  abstract = {{$E$}-values have recently emerged as a robust and flexible alternative to {$p$}-values for hypothesis testing, especially under optional continuation, i.e., when additional data from further experiments are collected. In this work we define optimal {$e$}-values for testing between maximum entropy models, in both the microcanonical (hard constraints) and canonical (soft constraints) settings. We show that, when testing between two hypotheses that are both microcanonical, the so-called growth-rate optimal e-variable admits an exact analytical expression, which also serves as a valid e-variable in the canonical case. For canonical tests, where exact solutions are typically unavailable, we introduce a microcanonical approximation and verify its excellent performance via both theoretical arguments and numerical simulations. We then consider constrained binary models, focusing on 2\texttimes{$k$} contingency tables---an essential framework in statistics and a natural representation for various models of complex systems. Our microcanonical optimal e-variable performs well in both settings, constituting a tool that remains effective even in the challenging case when the number {$k$} of groups grows with the sample size, as in models with growing features used for the analysis of real-world heterogeneous networks and time series.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/GNLCYYBX/Giuffrida et al. - 2026 - Testing maximum entropy models with $e$-values.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/WU4FW2TZ/xhf5-1l7p.html}
}

@article{givan_predicting_2011,
  title = {Predicting Epidemic Thresholds on Complex Networks: {{Limitations}} of Mean-Field Approaches},
  shorttitle = {Predicting Epidemic Thresholds on Complex Networks},
  author = {Givan, Or and Schwartz, Nehemia and Cygelberg, Assaf and Stone, Lewi},
  year = 2011,
  month = nov,
  journal = {Journal of Theoretical Biology},
  volume = {288},
  pages = {21--28},
  issn = {0022-5193},
  doi = {10.1016/j.jtbi.2011.07.015},
  url = {http://www.sciencedirect.com/science/article/pii/S0022519311003651},
  urldate = {2014-02-11},
  abstract = {Over the last decade considerable research effort has been invested in an attempt to understand the dynamics of viruses as they spread through complex networks, be they the networks in human population, computers or otherwise. The efforts have contributed to an understanding of epidemic behavior in random networks, but were generally unable to accommodate specific nonrandom features of the network's actual topology. Recently, though still in the context of the mean field theory, Chakrabarti et al. (2008) proposed a model that intended to take into account the graph's specific topology and solve a longstanding problem regarding epidemic thresholds in both random and nonrandom networks. Here we review previous theoretical work dealing with this problem (usually based on mean field approximations) and show with several relevant and concrete counter examples that results to date breakdown for nonrandom topologies.},
  keywords = {Eigenvalue,Markov chain,Poisson process,SIS model},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/H9DTMVM3/Givan et al. - 2011 - Predicting epidemic thresholds on complex networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/WQ53F9R2/S0022519311003651.html}
}

@article{gjoka_walk_2009,
  title = {A {{Walk}} in {{Facebook}}: {{Uniform Sampling}} of {{Users}} in {{Online Social Networks}}},
  shorttitle = {A {{Walk}} in {{Facebook}}},
  author = {Gjoka, Minas and Kurant, Maciej and Butts, Carter T and Markopoulou, Athina},
  year = 2009,
  month = may,
  journal = {0906.0060},
  eprint = {0906.0060},
  url = {http://arxiv.org/abs/0906.0060},
  urldate = {2009-09-02},
  abstract = {The popularity of online social networks (OSNs) has given rise to a number of measurements studies that provide a first step towards their understanding. So far, such studies have been based either on complete data sets provided directly by the OSN itself or on Breadth-First-Search (BFS) crawling of the social graph, which does not guarantee good statistical properties of the collected sample. In this paper, we crawl the publicly available social graph and present the first unbiased sampling of Facebook (FB) users using a Metropolis-Hastings random walk with multiple chains. We study the convergence properties of the walk and demonstrate the uniformity of the collected sample with respect to multiple metrics of interest. We provide a comparison of our crawling technique to baseline algorithms, namely BFS and simple random walk, as well as to the 'ground truth' obtained through truly uniform sampling of userIDs. Our contributions lie both in the measurement methodology and in the collected sample. With regards to the methodology, our measurement technique (i) applies and combines known results from random walk sampling specifically in the OSN context and (ii) addresses system implementation aspects that have made the measurement of Facebook challenging so far. With respect to the collected sample: (i) it is the first representative sample of FB users and we plan to make it publicly available; (ii) we perform a characterization of several key properties of the data set, and find that some of them are substantially different from what was previously believed based on non-representative OSN samples.},
