@article{xiong_recursive_2016,
  title = {Recursive {{Learning}} for {{Sparse Markov Models}}},
  author = {Xiong, Jie and J{\"a}{\"a}skinen, V{\"a}in{\"o} and Corander, Jukka},
  year = 2016,
  month = mar,
  journal = {Bayesian Analysis},
  volume = {11},
