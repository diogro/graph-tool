@article{ribeiro_mutual_2008,
  title = {Mutual Information in Random {{Boolean}} Models of Regulatory Networks},
  author = {Ribeiro, Andre S and Kauffman, Stuart A and {Lloyd-Price}, Jason and Samuelsson, Bj{\"o}rn and Socolar, Joshua E S},
  year = 2008,
  month = jan,
  journal = {Physical Review. E, Statistical, Nonlinear, and Soft Matter Physics},
  volume = {77},
  number = {1 Pt 1},
  eprint = {18351870},
  eprinttype = {pubmed},
  pages = {011901},
  issn = {1539-3755},
  url = {http://www.ncbi.nlm.nih.gov/pubmed/18351870},
  urldate = {2010-06-16},
  abstract = {The amount of mutual information contained in the time series of two elements gives a measure of how well their activities are coordinated. In a large, complex network of interacting elements, such as a genetic regulatory network within a cell, the average of the mutual information over all pairs, \emph{, is a global measure of how well the system can coordinate its internal dynamics. We study this average pairwise mutual information in random Boolean networks (RBNs) as a function of the distribution of Boolean rules implemented at each element, assuming that the links in the network are randomly placed. Efficient numerical methods for calculating \emph{ show that as the number of network nodes, N, approaches infinity, the quantity N\emph{ exhibits a discontinuity at parameter values corresponding to critical RBNs. For finite systems it peaks near the critical value, but slightly in the disordered regime for typical parameter variations. The source of high values of N\emph{ is the indirect correlations between pairs of elements from different long chains with a common starting point. The contribution from pairs that are directly linked approaches zero for critical networks and peaks deep in the disordered regime.}}}}},
  pmid = {18351870},
  keywords = {complex networks,Computational Biology,Computer Simulation,Gene Expression Regulation,genetics,Logistic Models,Models Biological,Models Statistical,Proteome,Signal Transduction}
}

@article{ribeiro_noisy_2007,
