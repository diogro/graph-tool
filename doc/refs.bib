@article{noh_stability_2002,
  title = {Stability of Shortest Paths in Complex Networks with Random Edge Weights},
  author = {Noh, Jae Dong and Rieger, Heiko},
  year = 2002,
  month = dec,
  journal = {Physical Review E},
  volume = {66},
  number = {6},
  pages = {066127},
  doi = {10.1103/PhysRevE.66.066127},
  url = {http://link.aps.org/doi/10.1103/PhysRevE.66.066127},
  urldate = {2010-04-15},
  abstract = {We study shortest paths and spanning trees of complex networks with random edge weights. Edges which do not belong to the spanning tree are inactive in a transport process within the network. The introduction of quenched disorder modifies the spanning tree such that some edges are activated and the network diameter is increased. With analytic random-walk mappings and numerical analysis, we find that the spanning tree is unstable to the introduction of disorder and displays a phase-transitionlike behavior at zero disorder strength {$\varepsilon$}=0. In the infinite network-size limit (N⃗{$\infty$}), we obtain a continuous transition with the density of activated edges {$\Phi$} growing like {$\Phi\sim\varepsilon$}1 and with the diameter-expansion coefficient {$\Upsilon$} growing like {$\Upsilon\sim\varepsilon$}2 in the regular network, and first-order transitions with discontinuous jumps in {$\Phi$} and {$\Upsilon$} at {$\varepsilon$}=0 for the small-world (SW) network and the Barab\'asi-Albert scale-free (SF) network. The asymptotic scaling behavior sets in when N{$\gg$}Nc, where the crossover size scales as Nc{$\sim\varepsilon$}-2 for the regular network, Nc{$\sim$}exp({$\alpha\varepsilon$}-2) for the SW network, and Nc{$\sim$}exp({$\alpha\vert$}ln{$\varepsilon\vert\varepsilon$}-2) for the SF network. In a transient regime with N{$\ll$}Nc, there is an infinite-order transition with {$\Phi\sim\Upsilon\sim$}exp[-{$\alpha$}/({$\varepsilon$}2lnN)] for the SW network and {$\sim$}exp[-{$\alpha$}/({$\varepsilon$}2lnN/lnlnN)] for the SF network. It shows that the transport pattern is practically most stable in the SF network.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/EGF89K3Q/Noh and Rieger - 2002 - Stability of shortest paths in complex networks wi.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9V69R9HH/e066127.html}
}

@article{norros_conditionally_2006,
  title = {On a Conditionally {{Poissonian}} Graph Process},
  author = {Norros, Ilkka and Reittu, Hannu},
  year = 2006,
  month = mar,
  journal = {Advances in Applied Probability},
  volume = {38},
  number = {1},
  pages = {59--75},
  issn = {0001-8678, 1475-6064},
  doi = {10.1239/aap/1143936140},
  url = {https://www.cambridge.org/core/journals/advances-in-applied-probability/article/on-a-conditionally-poissonian-graph-process/393757BC2FAE728A04FF583F92A8FFCD#},
  urldate = {2019-04-23},
  abstract = {Random (pseudo)graphs G N  with the following structure are studied: first, independent and identically distributed capacities {$\Lambda$} i  are drawn for vertices i = 1, \dots, N; then, each pair of vertices (i, j) is connected, independently of the other pairs, with E(i, j) edges, where E(i, j) has distribution Poisson({$\Lambda$} i  {$\Lambda$} j  / {$\sum$} k=1 N  {$\Lambda$} k ). The main result of the paper is that when P({$\Lambda$}1 {$>$} x) {$\geq$} x -{$\tau$}+1, where {$\tau$} {$\in$} (2, 3), then, asymptotically almost surely, G N  has a giant component, and the distance between two randomly selected vertices of the giant component is less than (2 + o(N))(log log N)/(-log ({$\tau$} - 2)). It is also shown that the cases {$\tau$} {$>$} 3, {$\tau$} {$\in$} (2, 3), and {$\tau$} {$\in$} (1, 2) present three qualitatively different connectivity architectures.},
  langid = {english},
  keywords = {05C12,05C80,branching process,giant component,power law,Random graph},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/DJLJ4BP7/Norros und Reittu - 2006 - On a conditionally Poissonian graph process.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/CIMD5XU5/393757BC2FAE728A04FF583F92A8FFCD.html}
}

