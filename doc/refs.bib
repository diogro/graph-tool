  year = 2010,
  month = aug,
  journal = {Physica A: Statistical Mechanics and its Applications},
  volume = {389},
  number = {15},
  pages = {2920--2929},
  issn = {0378-4371},
  doi = {10.1016/j.physa.2009.12.068},
  url = {http://www.sciencedirect.com/science/article/pii/S0378437110000336},
  urldate = {2012-01-16},
  abstract = {Recent studies introduced biased (degree-dependent) edge percolation as a model for failures in real-life systems. In this work, such process is applied to networks consisting of two types of nodes with edges running only between nodes of unlike type. Such bipartite graphs appear in many social networks, for instance in affiliation networks and in sexual-contact networks in which both types of nodes show the scale-free characteristic for the degree distribution. During the depreciation process, an edge between nodes with degrees k and q is retained with a probability proportional to ( k q ) - {$\alpha$} , where {$\alpha$} is positive so that links between hubs are more prone to failure. The removal process is studied analytically by introducing a generating functions theory. We deduce exact self-consistent equations describing the system at a macroscopic level and discuss the percolation transition. Critical exponents are obtained by exploiting the Fortuin--Kasteleyn construction which provides a link between our model and a limit of the Potts model.},
  keywords = {Bipartite networks,percolation,Scale-free networks,Sexual-contact network},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/N26AJ7K9/Hooyberghs et al. - 2010 - Percolation on bipartite scale-free networks;/home/count0/stuff/workspace/pesquisa/zotero/storage/WSRCG87G/Hooyberghs et al. - 2010 - Percolation on bipartite scale-free networks.pdf}
}

