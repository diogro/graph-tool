@article{boettcher_ordinary_2011,
  title = {Ordinary {{Percolation}} with {{Discontinuous Transitions}}},
  author = {Boettcher, S. and Singh, V. and Ziff, R. M},
  year = 2011,
  month = oct,
  journal = {arXiv:1110.4288},
  eprint = {1110.4288},
  url = {http://arxiv.org/abs/1110.4288},
  urldate = {2012-02-16},
  abstract = {Percolation on finitely ramified lattices, those where the loss of a finite number of bonds can forestall end-to-end transport when the number of nodes \$N\$ increases, is generally considered to be trivial. They percolate only at full bond density, \$p=1\$. Examples are the one-dimensional lattice and fractals such as the Sierpinski gasket. We show here that by dressing up such lattices with small-world bonds, in a way that the resulting network becomes infinitely ramified, an entirely novel percolation transition at a critical point \$p\_\textbraceleft c\textbraceright{$<$}1\$ emerges. Approaching this transition from below, many clusters of already diverging, yet, sub-extensive, sizes combine explosively at \$p\_\textbraceleft c\textbraceright\$ such that the resulting cluster becomes extensive. That is, the usual order parameter \$P\_\textbraceleft\textbackslash infty\textbraceright\$, describing the probability of any node to be part of the largest cluster, jumps instantly to a finite value at \$p\_\textbraceleft c\textbraceright\$. Simple examples of this transition are provided by small-world networks consisting of a one-dimensional lattice combined with various hierarchies of long-range bonds that reveal many features of the transition explicitly.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter,Condensed Matter - Disordered Systems and Neural Networks,Physical sciences,Theoretical physics},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/J8FVTP98/Boettcher et al. - 2012 - Ordinary percolation with discontinuous transition.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/ZX99B4HS/Boettcher et al. - 2011 - Ordinary Percolation with Discontinuous Transition.pdf}
}

