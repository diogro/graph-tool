@article{atay_synchronization_2006,
  title = {Synchronization of Networks with Prescribed Degree Distributions},
  author = {Atay, F.M. and Biyikoglu, T. and Jost, J.},
  year = 2006,
  month = jan,
  journal = {IEEE Transactions on Circuits and Systems I: Regular Papers},
  volume = {53},
  number = {1},
  pages = {92--98},
  issn = {1549-8328},
  doi = {10.1109/TCSI.2005.854604},
  abstract = {We show that the degree distributions of graphs do not suffice to characterize the synchronization of systems evolving on them. We prove that, for any given degree sequence satisfying certain conditions, there exists a connected graph having that degree sequence for which the first nontrivial eigenvalue of the graph Laplacian is arbitrarily close to zero. Consequently, complex dynamical systems defined on such graphs have poor synchronization properties. The result holds under quite mild assumptions, and shows that there exists classes of random, scale-free, regular, small-world, and other common network architectures which impede synchronization. The proof is based on a construction that also serves as an algorithm for building nonsynchronizing networks having a prescribed degree distribution.},
  keywords = {Buildings,complex dynamical systems,degree sequence,eigenvalues and eigenfunctions,graph theory,Impedance,IP networks,Iron,Laplace equations,Laplacian,Mathematics,network architectures,network topology,Networks,networks synchronization,nonsynchronizing networks,prescribed degree distributions,proteins,sequences,Shape,synchronisation,synchronization},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/5A7GUCJT/Atay et al. - 2006 - Synchronization of networks with prescribed degree.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9EW4CWTP/abs_all.html}
}

