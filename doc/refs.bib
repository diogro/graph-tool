  issn = {0016-6731, 1943-2631},
  url = {http://www.genetics.org/content/155/2/945},
  abstract = {We describe a model-based clustering method for using multilocus genotype data to infer population structure and assign individuals to populations. We assume a model in which there are K populations (where K may be unknown), each of which is characterized by a set of allele frequencies at each locus. Individuals in the sample are assigned (probabilistically) to populations, or jointly to two or more populations if their genotypes indicate that they are admixed. Our model does not assume a particular mutation process, and it can be applied to most of the commonly used genetic markers, provided that they are not closely linked. Applications of our method include demonstrating the presence of population structure, assigning individuals to populations, studying hybrid zones, and identifying migrants and admixed individuals. We show that the method can produce highly accurate assignments using modest numbers of loci---e.g., seven microsatellite loci in an example using genotype data from an endangered bird species. The software used for this article is available from http://www.stats.ox.ac.uk/\textasciitilde pritch/home.html.},
  copyright = {Copyright \copyright{} 2000 by the Genetics Society of America},
  langid = {english},
  pmid = {10835412},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/D744FFU8/Pritchard et al. - 2000 - Inference of Population Structure Using Multilocus.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/L6BTY3RK/945.html}
}

@inproceedings{prokhorenkova_modularity_2016,
  title = {Modularity of {{Complex Networks Models}}},
  booktitle = {Algorithms and {{Models}} for the {{Web Graph}}},
  author = {Prokhorenkova, Liudmila Ostroumova and Pra{\l}at, Pawe{\l} and Raigorodskii, Andrei},
  year = 2016,
  month = dec,
  series = {Lecture {{Notes}} in {{Computer Science}}},
  pages = {115--126},
  publisher = {Springer, Cham},
  doi = {10.1007/978-3-319-49787-7_10},
  url = {https://link.springer.com/chapter/10.1007/978-3-319-49787-7_10},
  abstract = {Modularity is designed to measure the strength of division of a network into clusters (known also as communities). Networks with high modularity have dense connections between the vertices within clusters but sparse connections between vertices of different clusters. As a result, modularity is often used in optimization methods for detecting community structure in networks, and so it is an important graph parameter from practical point of view. Unfortunately, many existing non-spatial models of complex networks do not generate graphs with high modularity; on the other hand, spatial models naturally create clusters. We investigate this phenomenon by considering a few examples from both sub-classes. We prove precise theoretical results for the classical model of random d-regular graphs as well as the preferential attachment model, and contrast these results with the ones for the spatial preferential attachment (SPA) model that is a model for complex networks in which vertices are embedded in a metric space, and each vertex has a sphere of influence whose size increases if the vertex gains an in-link, and otherwise decreases with time.},
  isbn = {978-3-319-49786-0 978-3-319-49787-7},
  langid = {english},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/694C38QH/Prokhorenkova et al. - 2016 - Modularity of Complex Networks Models.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/KJZE7HEE/978-3-319-49787-7_10.html}
}

