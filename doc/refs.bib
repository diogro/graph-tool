  shorttitle = {Statistical Mechanics of Ecological Systems},
  author = {Azaele, Sandro and Suweis, Samir and Grilli, Jacopo and Volkov, Igor and Banavar, Jayanth R. and Maritan, Amos},
  year = 2016,
  month = jul,
