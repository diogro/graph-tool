@article{munoz_colloquium:_2017,
  title = {Colloquium: {{Criticality}} and Dynamical Scaling in Living Systems},
  shorttitle = {Colloquium},
  author = {Mu{\~n}oz, Miguel A.},
  year = 2017,
  month = dec,
  journal = {arXiv:1712.04499 [cond-mat, physics:nlin, physics:physics, q-bio]},
  eprint = {1712.04499},
  primaryclass = {cond-mat, physics:nlin, physics:physics, q-bio},
  url = {http://arxiv.org/abs/1712.04499},
  urldate = {2017-12-21},
  abstract = {A celebrated and controversial hypothesis conjectures that some biological systems --parts, aspects, or groups of them-- may extract important functional benefits from operating at the edge of instability, halfway between order and disorder, i.e. in the vicinity of the critical point of a phase transition. Criticality has been argued to provide biological systems with an optimal balance between robustness against perturbations and flexibility to adapt to changing conditions, as well as to confer on them optimal computational capabilities, huge dynamical repertoires, unparalleled sensitivity to stimuli, etc. Criticality, with its concomitant scale invariance, can be conjectured to emerge in living systems as the result of adaptive and evolutionary processes that, for reasons to be fully elucidated, select for it as a template upon which higher layers of complexity can rest. This hypothesis is very suggestive as it proposes that criticality could constitute a general and common organizing strategy in biology stemming from the physics of phase transitions. However, despite its thrilling implications, this is still in its embryonic state as a well-founded theory and, as such, it has elicited some healthy skepticism. From the experimental side, the advent of high-throughput technologies has created new prospects in the exploration of biological systems, and empirical evidence in favor of criticality has proliferated, with examples ranging from endogenous brain activity and gene-expression patterns, to flocks of birds and insect-colony foraging, to name but a few...},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Statistical Mechanics,Nonlinear Sciences - Adaptation and Self-Organizing Systems,Physics - Biological Physics,Quantitative Biology - Quantitative Methods},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/WRLASPDN/Muñoz - 2017 - Colloquium Criticality and dynamical scaling in l.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/GLQTWHZ7/1712.html}
}

@misc{muratori_faster_2024,
  title = {Faster Algorithms for the Alignment of Sparse Correlated {{Erd}}\textbackslash "os-{{R}}\textbackslash 'enyi Random Graphs},
  author = {Muratori, Andrea and Semerjian, Guilhem},
  year = 2024,
  month = sep,
  number = {arXiv:2405.08421},
  eprint = {2405.08421},
  primaryclass = {cond-mat, stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2405.08421},
  url = {http://arxiv.org/abs/2405.08421},
  urldate = {2024-09-19},
  abstract = {The correlated Erd\textbackslash "os-R\textbackslash 'enyi random graph ensemble is a probability law on pairs of graphs with \$n\$ vertices, parametrized by their average degree \$\textbackslash lambda\$ and their correlation coefficient \$s\$. It can be used as a benchmark for the graph alignment problem, in which the labels of the vertices of one of the graphs are reshuffled by an unknown permutation; the goal is to infer this permutation and thus properly match the pairs of vertices in both graphs. A series of recent works has unveiled the role of Otter's constant \$\textbackslash alpha\$ (that controls the exponential rate of growth of the number of unlabeled rooted trees as a function of their sizes) in this problem: for \$s{$>\backslash$}sqrt\textbraceleft\textbackslash alpha\textbraceright\$ and \$\textbackslash lambda\$ large enough it is possible to recover in a time polynomial in \$n\$ a positive fraction of the hidden permutation. The exponent of this polynomial growth is however quite large and depends on the other parameters, which limits the range of applications of the algorithm. In this work we present a family of faster algorithms for this task, show through numerical simulations that their accuracy is only slightly reduced with respect to the original one, and conjecture that they undergo, in the large \$\textbackslash lambda\$ limit, phase transitions at modified Otter's thresholds \$\textbackslash sqrt\textbraceleft\textbackslash widehat\textbraceleft\textbackslash alpha\textbraceright\textbraceright{$>\backslash$}sqrt\textbraceleft\textbackslash alpha\textbraceright\$, with \$\textbackslash widehat\textbraceleft\textbackslash alpha\textbraceright\$ related to the enumeration of a restricted family of trees.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Data Structures and Algorithms,Condensed Matter - Disordered Systems and Neural Networks,Mathematics - Probability,Mathematics - Statistics Theory},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/RECQULSL/Muratori und Semerjian - 2024 - Faster algorithms for the alignment of sparse correlated Erdos-R'enyi random graphs.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/HUZ82YVY/2405.html}
}

