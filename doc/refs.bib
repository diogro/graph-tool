  publisher = {American Physical Society},
  doi = {10.1103/z3d5-94zb},
  url = {https://link.aps.org/doi/10.1103/z3d5-94zb},
  urldate = {2026-02-04},
  abstract = {We introduce group-based compartmental modeling (GBCM), a mean-field framework for irreversible contagion in higher-order networks that captures structural heterogeneity and correlations across group sizes. Validated through numerical simulations, GBCM analytically disentangles the role of each interaction order to the global epidemic dynamics, revealing how heterogeneity and inter-order correlations jointly shape the onset of outbreaks and the emergence of explosive dynamics. Crucially, we show that inter-order correlations drive the system along distinct pathways to explosive contagion---emerging universally across both irreversible and reversible spreading processes.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/745PRP7F/Malizia et al. - 2025 - Disentangling the Role of Heterogeneity and Hyperedge Overlap in Explosive Contagion on Higher-Order.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9RYIDN54/z3d5-94zb.html}
}

@article{malizia_hyperedge_2025,
  title = {Hyperedge Overlap Drives Explosive Transitions in Systems with Higher-Order Interactions},
  author = {Malizia, Federico and {Lamata-Ot{\'i}n}, Santiago and Frasca, Mattia and Latora, Vito and {G{\'o}mez-Garde{\~n}es}, Jes{\'u}s},
  year = 2025,
  month = jan,
  journal = {Nature Communications},
  volume = {16},
  number = {1},
  pages = {555},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-024-55506-1},
  url = {https://www.nature.com/articles/s41467-024-55506-1},
  urldate = {2026-01-14},
  abstract = {Recent studies have shown that novel collective behaviors emerge in complex systems due to the presence of higher-order interactions. However, how the collective behavior of a system is influenced by the microscopic organization of its higher-order interactions is not fully understood. In this work, we introduce a way to quantify the overlap among the hyperedges of a higher-order network, and we show that real-world systems exhibit different levels of intra-order hyperedge overlap. We then study two types of dynamical processes on higher-order networks, namely complex contagion and synchronization, finding that intra-order hyperedge overlap plays a universal role in determining the collective behavior in a variety of systems. Our results demonstrate that the presence of higher-order interactions alone does not guarantee abrupt transitions. Rather, explosivity and bistability require a microscopic organization of the structure with a low value of intra-order hyperedge overlap.},
  copyright = {2025 The Author(s)},
  langid = {english},
  keywords = {Complex networks,Statistical physics,thermodynamics and nonlinear dynamics},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/RJWIB948/Malizia et al. - 2025 - Hyperedge overlap drives explosive transitions in systems with higher-order interactions.pdf}
}

@misc{malizia_nested_2026,
  title = {Nested Hyperedges Promote the Onset of Collective Transitions but Suppress Explosive Behavior},
  author = {Malizia, Federico and Guzm{\'a}n, Andr{\'e}s and Battiston, Federico and Kiss, Istv{\'a}n Z.},
  year = 2026,
  month = jan,
  number = {arXiv:2601.10522},
  eprint = {2601.10522},
  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2601.10522},
  url = {http://arxiv.org/abs/2601.10522},
  urldate = {2026-01-26},
  abstract = {Higher-order interactions can dramatically reshape collective dynamics, yet how their microscopic organization controls macroscopic critical behavior remains unclear. Here we develop a new theory to study contagion dynamics on hypergraphs and show that nested hyperedges not only facilitate the onset of spreading, but also suppress backward bifurcations, thereby inhibiting explosive behavior. By disentangling contagion pathways, we find that overlap redirects transmission from external links to internal, group-embedded routes -- boosting early activation but making dyadic and triadic channels increasingly redundant. This loss of structural independence quenches the nonlinear amplification required for bistability, progressively smoothing the transition as hyperedges become nested. We observe the same phenomenology in Kuramoto dynamics, pointing to a broadly universal mechanism by which nested higher-order structure governs critical transitions in complex systems.},
  archiveprefix = {arXiv},
  keywords = {Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/N9PHF5KP/Malizia et al. - 2026 - Nested hyperedges promote the onset of collective transitions but suppress explosive behavior.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/BJ3N5AP9/2601.html}
}

@article{malizia_reconstructing_2024,
