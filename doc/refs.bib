  url = {http://www.sciencedirect.com/science/article/pii/S0378437199000795},
  urldate = {2016-06-09},
  abstract = {The number partitioning problem consists of partitioning a sequence of positive numbers \textbraceleft a1,a2,\dots,aN\textbraceright{} into two disjoint sets, A and B, such that the absolute value of the difference of the sums of aj over the two sets is minimized. We use statistical mechanics tools to study analytically the linear programming relaxation of this NP-complete integer programming. In particular, we calculate the probability distribution of the difference between the cardinalities of A and B and show that this difference is not self-averaging.},
  keywords = {Linear programming relaxation,Number partitioning},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/TC5B5HWC/Ferreira and Fontanari - 1999 - Statistical mechanics analysis of the continuous n.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/C5CM73EK/S0378437199000795.html}
