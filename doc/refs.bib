@article{bizhani_discontinuous_2012,
  title = {Discontinuous {{Percolation Transitions}} in {{Epidemic Processes}}, {{Surface Depinning}} in {{Random Media}} and {{Hamiltonian Random Graphs}}},
  author = {Bizhani, Golnoosh and Paczuski, Maya and Grassberger, Peter},
  year = 2012,
