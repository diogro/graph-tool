@article{wang_process-based_2010,
  title = {Process-Based Network Decomposition Reveals Backbone Motif Structure},
  author = {Wang, Guanyu and Du, Chenghang and Chen, Hao and Simha, Rahul and Rong, Yongwu and Xiao, Yi and Zeng, Chen},
  year = 2010,
