@article{gao_robustness_2011,
  title = {Robustness of a {{Tree}}-like {{Network}} of {{Interdependent Networks}}},
  author = {Gao, Jianxi and Buldyrev, S. V and Havlin, S. and Stanley, H. E},
  year = 2011,
  month = aug,
  journal = {arXiv:1108.5515},
  eprint = {1108.5515},
  url = {http://arxiv.org/abs/1108.5515},
  urldate = {2012-02-03},
  abstract = {In reality, many real-world networks interact with and depend on other networks. We develop an analytical framework for studying interacting networks and present an exact percolation law for a network of \$n\$ interdependent networks (NON). We present a general framework to study the dynamics of the cascading failures process at each step caused by an initial failure occurring in the NON system. We study and compare both \$n\$ coupled Erd\textbackslash H\textbraceleft o\textbraceright s-R\textbackslash '\textbraceleft e\textbraceright nyi (ER) graphs and \$n\$ coupled random regular (RR) graphs. We found recently [Gao et. al. arXive:1010.5829] that for an NON composed of \$n\$ ER networks each of average degree \$k\$, the giant component, \$P\_\textbraceleft\textbackslash infty\textbraceright\$, is given by \$P\_\textbraceleft\textbackslash infty\textbraceright =p[1-\textbackslash exp(-kP\_\textbraceleft\textbackslash infty\textbraceright )]\textasciicircum n\$ where \$1-p\$ is the initial fraction of removed nodes. Our general result coincides for \$n=1\$ with the known Erd\textbackslash H\textbraceleft o\textbraceright s-R\textbackslash '\textbraceleft e\textbraceright nyi second-order phase transition at a threshold, \$p=p\_c\$, for a single network. For \$n=2\$ the general result for \$P\_\textbraceleft\textbackslash infty\textbraceright\$ corresponds to the \$n=2\$ result [Buldyrev et. al., Nature, 464, (2010)]. Similar to the ER NON, for \$n=1\$ the percolation transition at \$p\_c\$, is of second order while for any \$n{$>$}1\$ it is of first order. The first order percolation transition in both ER and RR (for \$n{$>$}1\$) is accompanied by cascading failures between the networks due to their interdependencies. However, we find that the robustness of \$n\$ coupled RR networks of degree \$k\$ is dramatically higher compared to the \$n\$ coupled ER networks of average degree \$k\$. While for ER NON there exists a critical minimum average degree \$k=k\_\textbraceleft\textbackslash min\textbraceright\$, that increases with \$n\$, below which the system collapses, there is no such analogous \$k\_\textbraceleft\textbackslash min\textbraceright\$ for RR NON system.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Physics - Data Analysis Statistics and Probability,Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/WGPWTRS5/Gao et al. - 2011 - Robustness of a Tree-like Network of Interdependen.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/TRBEXFR8/1108.html}
}

@article{gao_robustness_2011-1,
  title = {Robustness of a {{Network}} of {{Networks}}},
  author = {Gao, Jianxi and Buldyrev, Sergey V. and Havlin, Shlomo and Stanley, H. Eugene},
