@article{ramos-fernandez_uncovering_2026,
  title = {Uncovering Complementary Information Sharing in Spider Monkey Collective Foraging Using Higher-Order Spatial Networks},
  author = {{Ramos-Fernandez}, Gabriel and Walker, Ross S. and Silk, Matthew J. and Boyer, Denis and Smith Aguilar, Sandra E.},
  year = 2026,
  month = jan,
  journal = {npj Complexity},
