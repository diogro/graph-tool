  author = {Ma'ayan, Avi and Jenkins, Sherry L and Neves, Susana and Hasseldine, Anthony and Grace, Elizabeth and {Dubin-Thaler}, Benjamin and Eungdamrong, Narat J and Weng, Gehzi and Ram, Prahlad T and Rice, J. Jeremy and Kershenbaum, Aaron and Stolovitzky, Gustavo A and Blitzer, Robert D and Iyengar, Ravi},
  year = 2005,
