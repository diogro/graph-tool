@article{dreyer_irreversible_2009,
  title = {Irreversible K-Threshold Processes: {{Graph}}-Theoretical Threshold Models of the Spread of Disease and of Opinion},
  shorttitle = {Irreversible K-Threshold Processes},
  author = {Dreyer, Paul A. and Roberts, Fred S.},
  year = 2009,
  month = apr,
  journal = {Discrete Applied Mathematics},
  volume = {157},
