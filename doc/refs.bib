@article{comtet_integer_2007,
  title = {Integer {{Partitions}} and {{Exclusion Statistics}}},
  author = {Comtet, Alain and Majumdar, Satya N. and Ouvry, Stephane},
  year = 2007,
  month = sep,
  journal = {Journal of Physics A: Mathematical and Theoretical},
  volume = {40},
  number = {37},
  eprint = {0705.2640},
  pages = {11255--11269},
  issn = {1751-8113, 1751-8121},
  doi = {10.1088/1751-8113/40/37/004},
  url = {http://arxiv.org/abs/0705.2640},
  urldate = {2016-06-09},
  abstract = {We provide a combinatorial description of exclusion statistics in terms of minimal difference \$p\$ partitions. We compute the probability distribution of the number of parts in a random minimal \$p\$ partition. It is shown that the bosonic point \$ p=0\$ is a repulsive fixed point for which the limiting distribution has a Gumbel form. For all positive \$p\$ the distribution is shown to be Gaussian.},
