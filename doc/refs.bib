@article{krakauer_challenges_2011,
  title = {The Challenges and Scope of Theoretical Biology},
  author = {Krakauer, David C. and Collins, James P. and Erwin, Douglas and Flack, Jessica C. and Fontana, Walter and Laubichler, Manfred D. and Prohaska, Sonja J. and West, Geoffrey B. and Stadler, Peter F.},
  year = 2011,
  month = may,
  journal = {Journal of Theoretical Biology},
  volume = {276},
  number = {1},
  pages = {269--276},
  issn = {0022-5193},
  doi = {16/j.jtbi.2011.01.051},
  url = {http://www.sciencedirect.com/science/article/pii/S0022519311000774},
  urldate = {2011-07-19},
  abstract = {{$<$}p{$><$}br/{$>$}Scientific theories seek to provide simple explanations for significant empirical regularities based on fundamental physical and mechanistic constraints. Biological theories have rarely reached a level of generality and predictive power comparable to physical theories. This discrepancy is explained through a combination of frozen accidents, environmental heterogeneity, and widespread non-linearities observed in adaptive processes. At the same time, model building has proven to be very successful when it comes to explaining and predicting the behavior of particular biological systems. In this respect biology resembles alternative model-rich frameworks, such as economics and engineering. In this paper we explore the prospects for general theories in biology, and suggest that these take inspiration not only from physics, but also from the information sciences. Future theoretical biology is likely to represent a hybrid of parsimonious reasoning and algorithmic or rule-based explanation. An open question is whether these new frameworks will remain transparent to human reason. In this context, we discuss the role of machine learning in the early stages of scientific discovery. We argue that evolutionary history is not only a source of uncertainty, but also provides the basis, through conserved traits, for very general explanations for biological regularities, and the prospect of unified theories of life.{$<$}/p{$>$}},
  keywords = {Computation,Model,Parsimony,Physics,theory},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/CUB2J8KX/Krakauer et al. - 2011 - The challenges and scope of theoretical biology.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/A5KUMGE9/S0022519311000774.html}
}

