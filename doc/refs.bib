@article{mistry_inferring_2020,
  title = {Inferring High-Resolution Human Mixing Patterns for Disease Modeling},
  author = {Mistry, Dina and Litvinova, Maria and y Piontti, Ana Pastore and Chinazzi, Matteo and Fumanelli, Laura and Gomes, Marcelo F. C. and Haque, Syed A. and Liu, Quan-Hui and Mu, Kunpeng and Xiong, Xinyue and Halloran, M. Elizabeth and Longini Jr., Ira M. and Merler, Stefano and Ajelli, Marco and Vespignani, Alessandro},
  year = 2020,
  month = feb,
  journal = {arXiv:2003.01214 [physics, q-bio]},
  eprint = {2003.01214},
  primaryclass = {physics, q-bio},
  url = {http://arxiv.org/abs/2003.01214},
  urldate = {2020-03-12},
  abstract = {Mathematical and computational modeling approaches are increasingly used as quantitative tools in the analysis and forecasting of infectious disease epidemics. The growing need for realism in addressing complex public health questions is however calling for accurate models of the human contact patterns that govern the disease transmission processes. Here we present a data-driven approach to generate effective descriptions of population-level contact patterns by using highly detailed macro (census) and micro (survey) data on key socio-demographic features. We produce age-stratified contact matrices for 277 sub-national administrative regions of countries covering approximately 3.5 billion people and reflecting the high degree of cultural and societal diversity of the focus countries. We use the derived contact matrices to model the spread of airborne infectious diseases and show that sub-national heterogeneities in human mixing patterns have a marked impact on epidemic indicators such as the reproduction number and overall attack rate of epidemics of the same etiology. The contact patterns derived here are made publicly available as a modeling tool to study the impact of socio-economic differences and demographic heterogeneities across populations on the epidemiology of infectious diseases.},
  archiveprefix = {arXiv},
  keywords = {Physics - Physics and Society,Quantitative Biology - Populations and Evolution,Quantitative Biology - Quantitative Methods},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/F4LAC3NN/Mistry et al. - 2020 - Inferring high-resolution human mixing patterns fo.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/VUUY5I4X/2003.html}
