  url = {https://link.aps.org/doi/10.1103/PhysRevX.12.011004},
  urldate = {2022-05-17},
  abstract = {Network homophily, the tendency of similar nodes to be connected, and transitivity, the tendency of two nodes to be connected if they share a common neighbor, are conflated properties in network analysis since one mechanism can drive the other. Here, we present a generative model and corresponding inference procedure that are capable of distinguishing between both mechanisms. Our approach is based on a variation of the stochastic block model (SBM) with the addition of triadic closure edges, and its inference can identify the most plausible mechanism responsible for the existence of every edge in the network, in addition to the underlying community structure itself. We show how the method can evade the detection of spurious communities caused solely by the formation of triangles in the network and how it can improve the performance of edge prediction when compared to the pure version of the SBM without triadic closure.},
  archiveprefix = {arXiv},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/ZXVXH4RT/Peixoto - 2022 - Disentangling Homophily, Community Structure, and .pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/Y6WEPMM8/PhysRevX.12.html}
}

@article{peixoto_efficient_2014,
  title = {Efficient {{Monte Carlo}} and Greedy Heuristic for the Inference of Stochastic Block Models},
  author = {Peixoto, Tiago P.},
  year = {2014},
  month = jan,
