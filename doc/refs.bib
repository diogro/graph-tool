  pages = {475--478},
  issn = {0250-5991},
  doi = {10.1007/BF02705043},
  url = {http://www.springerlink.com/content/f11pp213552m2782/abstract/},
  urldate = {2012-06-28},
  abstract = {Kleiber's law in biology states that the specific metabolic rate (metabolic rate per unit mass) scales as M -1/2 in terms of the mass M of the organism. A long-standing puzzle is the (-1/4) power in place of the usual expectation of (-1/3) based on the surface to volume ratio in three-dimensions. While recent papers by physicists have focused exclusively on geometry in attempting to explain the puzzle, we consider here a specific law of physics that governs fluid flow to show how the (-1/4) power arises under certain conditions. More generally, such a line of approach that identifies a specific physical law as involved and then examines the implications of a power law may illuminate better the role of physics in biology.},
  keywords = {Biomedical and Life Sciences},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/ED8VVZTE/Rau - 2002 - Biological scaling and physics.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/4IB6ANVV/abstract.html}
}

@article{ravasz_hierarchical_2002,
