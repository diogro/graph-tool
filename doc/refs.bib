@article{grilli_macroecological_2020,
  title = {Macroecological Laws Describe Variation and Diversity in Microbial Communities},
  author = {Grilli, Jacopo},
  year = 2020,
  month = sep,
  journal = {Nature Communications},
  volume = {11},
