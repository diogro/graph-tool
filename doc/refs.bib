@article{glass_logical_2010,
  title = {Logical and Symbolic Analysis of Robust Biological Dynamics},
  author = {Glass, Leon and Siegelmann, Hava T},
  year = 2010,
  month = dec,
  journal = {Current Opinion in Genetics \& Development},
  volume = {20},
  number = {6},
