@article{grunwald_minimum_2019,
  title = {Minimum {{Description Length Revisited}}},
  author = {Gr{\"u}nwald, Peter and Roos, Teemu},
  year = 2019,
  month = aug,
  journal = {arXiv:1908.08484 [cs, math, stat]},
  eprint = {1908.08484},
  primaryclass = {cs, math, stat},
  url = {http://arxiv.org/abs/1908.08484},
  urldate = {2019-08-23},
  abstract = {This is an up-to-date introduction to and overview of the Minimum Description Length (MDL) Principle, a theory of inductive inference that can be applied to general problems in statistics, machine learning and pattern recognition. While MDL was originally based on data compression ideas, this introduction can be read without any knowledge thereof. It takes into account all major developments since 2007, the last time an extensive overview was written. These include new methods for model selection and averaging and hypothesis testing, as well as the first completely general definition of \textbraceleft\textbackslash em MDL estimators\textbraceright. Incorporating these developments, MDL can be seen as a powerful extension of both penalized likelihood and Bayesian approaches, in which penalization functions and prior distributions are replaced by more general luckiness functions, average-case methodology is replaced by a more robust worst-case approach, and in which methods classically viewed as highly distinct, such as AIC vs BIC and cross-validation vs Bayes can, to a large extent, be viewed from a unified perspective.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Information Theory,Computer Science - Machine Learning,Statistics - Machine Learning,Statistics - Methodology},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/AA4P9Z8E/Grünwald und Roos - 2019 - Minimum Description Length Revisited.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/9T9FGII7/1908.html}
}

