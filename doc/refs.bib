  urldate = {2023-12-15},
  abstract = {A Java parallel streams implementation of the \$K\$-nearest neighbor descent algorithm is presented using a natural statistical termination criterion. Input data consist of a set \$S\$ of \$n\$ objects of type V, and a Function, which enables any \$x \textbackslash in S\$ to decide which of \$y, z \textbackslash in S\textbackslash setminus\textbackslash\textbraceleft x\textbackslash\textbraceright\$ is more similar to \$x\$. Experiments with the Kullback-Leibler divergence Comparator support the prediction that the number of rounds of \$K\$-nearest neighbor updates need not exceed twice the diameter of the undirected version of a random regular out-degree \$K\$ digraph on \$n\$ vertices. Overall complexity was \$O(n K\textasciicircum 2 \textbackslash log\_K(n))\$ in the class of examples studied. When objects are sampled uniformly from a \$d\$-dimensional simplex, accuracy of the \$K\$-nearest neighbor approximation is high up to \$d = 20\$, but declines in higher dimensions, as theory would predict.},
  archiveprefix = {arXiv},
  keywords = {90C35,Computer Science - Machine Learning,F.2.2,Statistics - Machine Learning},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/2XELVUJI/Baron und Darling - 2022 - Empirical complexity of comparator-based nearest n.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/YKKLCRBX/2202.html}
}

@misc{baron_k-nearest_2020,
