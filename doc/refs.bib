@article{nortier_higher-order_2025,
  title = {Higher-Order Shortest Paths in Hypergraphs},
  author = {Nortier, Bern{\'e} L. and Dobson, Simon and Battiston, Federico},
  year = 2025,
  month = nov,
  journal = {Physical Review E},
  volume = {112},
  number = {5},
  pages = {054302},
  publisher = {American Physical Society},
  doi = {10.1103/1mxy-3cnl},
  url = {https://link.aps.org/doi/10.1103/1mxy-3cnl},
  urldate = {2026-01-26},
  abstract = {One of the defining features of complex networks is the connectivity properties that we observe emerging from local interactions. Recently, hypergraphs have emerged as a versatile tool to model networks with nondyadic, higher-order interactions. Nevertheless, the connectivity properties of real-world hypergraphs remain largely understudied. In this work we introduce path size as a measure to characterize higher-order connectivity and quantify the relevance of nondyadic ties for efficient shortest paths in a diverse set of empirical networks with and without temporal information. By comparing our results with simple randomized null models, our analysis presents a nuanced picture, suggesting that nondyadic ties are often central and are vital for system connectivity, while dyadic edges remain essential to connect more peripheral nodes, an effect which is particularly pronounced for time-varying systems. Our work contributes to a better understanding of the structural organization of systems with higher-order interactions.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/7LW4J6NX/Nortier et al. - 2025 - Higher-order shortest paths in hypergraphs.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/ND7EI7QI/1mxy-3cnl.html}
}

@article{norwell_threshold_2012,
  title = {A {{Threshold For Clusters}} in {{Real-World Random Networks}}},
  author = {Norwell, Arron},
  year = 2012,
  month = nov,
  journal = {arXiv:1211.0736},
  eprint = {1211.0736},
  url = {http://arxiv.org/abs/1211.0736},
  urldate = {2012-11-16},
  abstract = {Recent empirical work [Leskovec2009] has suggested the existence of a size threshold for the existence of clusters within many real-world networks. We give the first proof that this clustering size threshold exists within a real-world random network model, and determine the asymptotic value at which it occurs. More precisely, we choose the Community Guided Attachment (CGA) random network model of Leskovek, Kleinberg, and Faloutsos [Leskovec2005]. The model is non-uniform and contains self-similar communities, and has been shown to have many properties of real-world networks. To capture the notion of clustering, we follow Mishra et. al. [Mishra2007], who defined a type of clustering for real-world networks: an (\textbackslash alpha,\textbackslash beta)-cluster is a set that is both internally dense (to the extent given by the parameter \textbackslash beta), and externally sparse (to the extent given by the parameter \textbackslash alpha) . With this definition of clustering, we show the existence of a size threshold of (\textbackslash ln n)\textasciicircum\textbraceleft 1/2\textbraceright{} for the existence of clusters in the CGA model. For all \textbackslash epsilon{$>$}0, a.a.s. clusters larger than (\textbackslash ln n)\textasciicircum\textbraceleft 1/2-\textbackslash epsilon\textbraceright{} exist, whereas a.a.s. clusters larger than (\textbackslash ln n)\textasciicircum\textbraceleft 1/2+\textbackslash epsilon\textbraceright{} do not exist. Moreover, we show a size bound on the existence of small, constant-size clusters.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/2UF97ATS/Norwell - 2012 - A Threshold For Clusters in Real-World Random Netw.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/SNFTHSDA/1211.html}
}

