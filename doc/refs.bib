@article{smieja_entropy_2012,
  title = {Entropy of the {{Mixture}} of {{Sources}} and {{Entropy Dimension}}},
  author = {Smieja, M. and Tabor, J.},
  year = 2012,
  month = may,
  journal = {Information Theory, IEEE Transactions on},
  volume = {58},
  number = {5},
  pages = {2719--2728},
  issn = {0018-9448},
  doi = {10.1109/TIT.2011.2181820},
  abstract = {Suppose that we are given two sources \emph{S}\textsubscript{1}, \emph{S}\textsubscript{2} which both send us information from the data space \emph{X} . We assume that we lossy-code information coming from \emph{S}\textsubscript{1} and \emph{S}\textsubscript{2} with the same maximal error but with different alphabets \emph{P}\textsubscript{1} and \emph{P}\textsubscript{2}, respectively. Consider a new source \emph{S} which sends a signal produced by source \emph{S}\textsubscript{1} with probability \emph{a}\textsubscript{1} and by source \emph{S}\textsubscript{2} with probability \emph{a}\textsubscript{2}=1-\emph{a}\textsubscript{1} . We provide a simple greedy algorithm which constructs a coding alphabet \emph{P} which encodes data from \emph{S} with the same value of maximal error as single sources, such that the entropy \emph{h}(\emph{S};\emph{P}) satisfies: h(S;P) \#x2264; a\textsubscript{1}h(S\textsubscript{1};P\textsubscript{1})+a\textsubscript{2}h(S\textsubscript{2};P\textsubscript{2}) +1. In the proof of the aforementioned formula, the basic role is played by a new equivalent definition of entropy based on measures instead of partitions. As a consequence, we decompose the entropy dimension of the mixture of sources in terms of the convex combination of the entropy dimensions of the single sources. In the case of probability measures in BBR\textsuperscript{N}, this allows us to link the upper local dimension at point with the upper entropy dimension of a measure by an improved version of Young estimation.},
  keywords = {aforementioned formula,coding alphabet,convex combination,convex programming,entropy codes,entropy dimension,equivalent definition,estimation theory,greedy algorithm,lossy-code information,maximal error,probability,probability measures,single sources,Young estimation},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/VRGE7CBU/Smieja and Tabor - 2012 - Entropy of the Mixture of Sources and Entropy Dime.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/KQZ6QN7V/stamp.html}
}

@misc{smiley_approximate_2024,
  title = {Approximate {{Inference}} for {{Longitudinal Mechanistic HIV Contact Networks}}},
  author = {Smiley, Octavious and Hoffmann, Till and Onnela, Jukka-Pekka},
  year = 2024,
  month = jan,
  number = {arXiv:2401.04775},
  eprint = {2401.04775},
  primaryclass = {stat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2401.04775},
  url = {http://arxiv.org/abs/2401.04775},
  urldate = {2024-03-16},
  abstract = {Network models are increasingly used to study infectious disease spread. Exponential Random Graph models have a history in this area, with scalable inference methods now available. An alternative approach uses mechanistic network models. Mechanistic network models directly capture individual behaviors, making them suitable for studying sexually transmitted diseases. Combining mechanistic models with Approximate Bayesian Computation allows flexible modeling using domain-specific interaction rules among agents, avoiding network model oversimplifications. These models are ideal for longitudinal settings as they explicitly incorporate network evolution over time. We implemented a discrete-time version of a previously published continuous-time model of evolving contact networks for men who have sex with men (MSM) and proposed an ABC-based approximate inference scheme for it. As expected, we found that a two-wave longitudinal study design improves the accuracy of inference compared to a cross-sectional design. However, the gains in precision in collecting data twice, up to 18\%, depend on the spacing of the two waves and are sensitive to the choice of summary statistics. In addition to methodological developments, our results inform the design of future longitudinal network studies in sexually transmitted diseases, specifically in terms of what data to collect from participants and when to do so.},
  archiveprefix = {arXiv},
  keywords = {Statistics - Methodology},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/DUV85LE5/Smiley et al. - 2024 - Approximate Inference for Longitudinal Mechanistic.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/8I4WZJJD/2401.html}
}

@article{smilkov_analytically_2011,
  title = {Analytically Solvable Processes on Networks},
  author = {Smilkov, Daniel and Kocarev, Ljupco},
  year = 2011,
  month = mar,
  journal = {1103.2252},
  eprint = {1103.2252},
  url = {http://arxiv.org/abs/1103.2252},
  urldate = {2011-04-19},
  abstract = {We introduce a broad class of analytically solvable processes on networks. In the special case, they reduce to random walk and consensus process - two most basic processes on networks. Our class differs from previous models of interactions (such as stochastic Ising model, cellular automata, infinite particle system, and voter model) in several ways, two most important being: (i) the model is analytically solvable even when the dynamical equation for each node may be different and the network may have an arbitrary finite graph and influence structure; and (ii) in addition, when local dynamic is described by the same evolution equation, the model is decomposable: the equilibrium behavior of the system can be expressed as an explicit function of network topology and node dynamics},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Condensed Matter - Statistical Mechanics,Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/VFJCTJX8/Smilkov and Kocarev - 2011 - Analytically solvable processes on networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/TMSXS6Q4/1103.html}
}

@article{smilkov_rich-club_2011,
  title = {Rich-Club and Page-Club Coefficients for Directed Graphs},
  author = {Smilkov, Daniel and Kocarev, Ljupco},
  year = 2011,
  month = mar,
  journal = {1103.2264},
  eprint = {1103.2264},
  doi = {doi:10.1016/j.physa.2010.02.001},
  url = {http://arxiv.org/abs/1103.2264},
  urldate = {2011-04-19},
  abstract = {Rich-club and page-club coefficients and their null models are introduced for directed graphs. Null models allow for a quantitative discussion of the rich-club and page-club phenomena. These coefficients are computed for four directed real-world networks: Arxiv High Energy Physics paper citation network, Web network (released from Google), Citation network among US Patents, and Email network from a EU research institution. The results show a high correlation between rich-club and page-club ordering. For journal paper citation network, we identify both rich-club and page-club ordering, showing that \textbraceleft\textbraceright "elite" papers are cited by other \textbraceleft\textbraceright "elite" papers. Google web network shows partial rich-club and page-club ordering up to some point and then a narrow declining of the corresponding normalized coefficients, indicating the lack of rich-club ordering and the lack of page-club ordering, i.e. high in-degree (PageRank) pages purposely avoid sharing links with other high in-degree (PageRank) pages. For UC patents citation network, we identify page-club and rich-club ordering providing a conclusion that \textbraceleft\textbraceright "elite" patents are cited by other \textbraceleft\textbraceright "elite" patents. Finally, for e-mail communication network we show lack of both rich-club and page-club ordering. We construct an example of synthetic network showing page-club ordering and the lack of rich-club ordering.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Social and Information Networks,Condensed Matter - Statistical Mechanics,Physics - Physics and Society},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/RSN62XMF/Smilkov and Kocarev - 2011 - Rich-club and page-club coefficients for directed .pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/NWVSXG2D/1103.html}
}

