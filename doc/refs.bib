  month = mar,
  journal = {1103.4490},
  eprint = {1103.4490},
  url = {http://arxiv.org/abs/1103.4490},
  urldate = {2011-05-14},
  abstract = {Regulatory dynamics in systems biology is often described by continuous rate equations for continuously varying chemical concentrations. Binary discretization of state space and time leads to Boolean dynamics. In the latter, the distinction between stable and unstable dynamics is usually made by checking damage after flip perturbations. Here we point out that this notion of stability is incompatible with the stability properties of the original continuous dynamics probed by small perturbations. In particular, random networks of nodes with large sensitivity yield stable dynamics, in contrast to the prediction of chaos obtained by flip perturbations in Boolean networks.},
  archiveprefix = {arXiv},
  keywords = {Physics - Biological Physics,Quantitative Biology - Molecular Networks},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/J3DEA9QP/Ghanbarnejad and Klemm - 2011 - Stability of Boolean and continuous dynamics.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/7NM8P7EG/1103.html}
}

@inproceedings{ghaoui_convex_2008,
  title = {A {{Convex Upper Bound}} on the {{Log-Partition Function}} for {{Binary Distributions}}},
