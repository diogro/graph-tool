  pages = {9960--9965},
  doi = {10.1073/pnas.0400731101},
  url = {http://www.pnas.org/content/101/27/9960.abstract},
  urldate = {2010-12-15},
  abstract = {Stochastic computing has a broad range of applications, yet electronic computers realize its basic step, stochastic choice between alternative computation paths, in a cumbersome way. Biomolecular computers use a different computational paradigm and hence afford novel designs. We constructed a stochastic molecular automaton in which stochastic choice is realized by means of competition between alternative biochemical pathways, and choice probabilities are programmed by the relative molar concentrations of the software molecules coding for the alternatives. Programmable and autonomous stochastic molecular automata have been shown to perform direct analysis of disease-related molecular indicators in vitro and may have the potential to provide in situ medical diagnosis and cure.},
  keywords = {unread},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/TFDSVU2J/Adar et al. - 2004 - Stochastic computing with biomolecular automata.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/G8N426NE/9960.html}
