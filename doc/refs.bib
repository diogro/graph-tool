  url = {http://link.aps.org/doi/10.1103/PhysRevLett.95.188701},
  urldate = {2013-02-23},
  abstract = {A new family of graphs, entangled networks, with optimal properties in many respects, is introduced. By definition, their topology is such that it optimizes synchronizability for many dynamical processes. These networks are shown to have an extremely homogeneous structure: degree, node distance, betweenness, and loop distributions are all very narrow. Also, they are characterized by a very interwoven (entangled) structure with short average distances, large loops, and no well-defined community structure. This family of nets exhibits an excellent performance with respect to other flow properties such as robustness against errors and attacks, minimal first-passage time of random walks, efficient communication, etc. These remarkable features convert entangled networks in a useful concept, optimal or almost optimal in many senses, and with plenty of potential applications in computer science or neuroscience.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/UAJH5ID5/Donetti et al. - 2005 - Entangled Networks, Synchronization, and Optimal N.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/XFZQ3B4C/Donetti et al. - 2005 - Entangled Networks, Synchronization, and Optimal N.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/NHKDCGBE/e188701.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/VUEBPRPE/e188701.html}
