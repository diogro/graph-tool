@article{peixoto_parsimonious_2013,
  title = {Parsimonious {{Module Inference}} in {{Large Networks}}},
  author = {Peixoto, Tiago P.},
  year = 2013,
  month = apr,
  journal = {Physical Review Letters},
  volume = {110},
  number = {14},
