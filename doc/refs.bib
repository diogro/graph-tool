@article{yen_community_2020,
  title = {Community {{Detection}} in {{Bipartite Networks}} with {{Stochastic Blockmodels}}},
  author = {Yen, Tzu-Chi and Larremore, Daniel B.},
  year = 2020,
  month = jan,
  journal = {arXiv:2001.11818 [physics, stat]},
  eprint = {2001.11818},
  primaryclass = {physics, stat},
  url = {http://arxiv.org/abs/2001.11818},
  urldate = {2020-06-25},
  abstract = {In bipartite networks, community structures are restricted to being disassortative, in that nodes of one type are grouped according to common patterns of connection with nodes of the other type. This makes the stochastic block model (SBM), a highly flexible generative model for networks with block structure, an intuitive choice for bipartite community detection. However, typical formulations of the SBM do not make use of the special structure of bipartite networks. In this work, we introduce a Bayesian nonparametric formulation of the SBM and a corresponding algorithm to efficiently find communities in bipartite networks without overfitting. The biSBM improves community detection results over general SBMs when data are noisy, improves the model resolution limit by a factor of \$\textbackslash sqrt\textbraceleft 2\textbraceright\$, and expands our understanding of the complicated optimization landscape associated with community detection tasks. A direct comparison of certain terms of the prior distributions in the biSBM and a related high-resolution hierarchical SBM also reveals a counterintuitive regime of community detection problems, populated by smaller and sparser networks, where non-hierarchical models outperform their more flexible counterpart.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning,Computer Science - Social and Information Networks,Physics - Physics and Society,Statistics - Machine Learning},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/ZVMVWP6B/Yen und Larremore - 2020 - Community Detection in Bipartite Networks with Sto.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/QMAZAZTB/2001.html}
}

