@article{di_gaetano_dynamical_2024,
  title = {Dynamical {{Fluctuations}} of {{Random Walks}} in {{Higher-Order Networks}}},
  author = {Di Gaetano, Leonardo and Carugno, Giorgio and Battiston, Federico and Coghi, Francesco},
  year = 2024,
  month = sep,
  journal = {Physical Review Letters},
  volume = {133},
  number = {10},
  pages = {107401},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.133.107401},
  url = {https://link.aps.org/doi/10.1103/PhysRevLett.133.107401},
  urldate = {2026-01-26},
  abstract = {Although higher-order interactions are known to affect the typical state of dynamical processes giving rise to new collective behavior, how they drive the emergence of rare events and fluctuations is still an open problem. We investigate how fluctuations of a dynamical quantity of a random walk exploring a higher-order network arise over time. In the quenched case, where the hypergraph structure is fixed, through large deviation theory we show that the appearance of rare events is hampered in nodes with many higher-order interactions, and promoted elsewhere. Dynamical fluctuations are further boosted in an annealed scenario, where both the diffusion process and higher-order interactions evolve in time. Here, extreme fluctuations generated by optimal higher-order configurations can be predicted in the limit of a saddle-point approximation. Our study lays the groundwork for a wide and general theory of fluctuations and rare events in higher-order networks.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/UN2VQAU9/Di Gaetano et al. - 2024 - Dynamical Fluctuations of Random Walks in Higher-Order Networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/25QY6P58/PhysRevLett.133.html}
}

@article{di_gaetano_percolation_2024,
