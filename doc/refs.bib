  author = {{Font-Pomarol}, Lluc and Piga, Angelo and {Garcia-Teruel}, Rosa Maria and {Nasarre-Aznar}, Sergio and {Sales-Pardo}, Marta and Guimer{\`a}, Roger},
  year = 2023,
