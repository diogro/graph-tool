@article{diez_how_2023,
  title = {How Do Networks Explain? {{A}} Neo-Hempelian Approach to Network Explanations of the Ecology of the Microbiome},
  shorttitle = {How Do Networks Explain?},
  author = {D{\'i}ez, Jos{\'e} and Su{\'a}rez, Javier},
  year = 2023,
  month = sep,
  journal = {European Journal for Philosophy of Science},
  volume = {13},
