  url = {http://qjmath.oxfordjournals.org/content/38/1/77},
  urldate = {2012-07-01},
  abstract = {LET {$\psi$} = (an){$\infty$}1 be a decreasing sequence of positive numbers whose sum is 1, and K be a closed set in [0,1] whose complementary intervals have lengths an. Besicovitch and Taylor [1] define two indices {$\alpha$}({$\psi$}) and {$\beta$}({$\psi$}), and prove that the Hausdorff dimension dim K {$\leq$} {$\alpha$}({$\psi$}) always, and that dim K can assume all the values in [0, {$\alpha$}] if {$\alpha$} {$>$} 0. Hawkes [3] constructs a random set K({$\omega$}) such that dim K({$\omega$}) = {$\alpha$}({$\psi$}) almost surely. Our purpose is to obtain a similar realization for {$\beta$}({$\psi$}), the exponent of convergence of {$\psi$}, and for a more recondite number denoted {$\beta$}0({$\psi$}). Each of these numbers is a sort of additive dimension, which we define presently.},
  langid = {english},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/EHEENWKX/Kaufman - 1987 - Entropy, Dimension, and Random Sets.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/RPTTUWF4/77.html}
}

