  author = {Nelson, Amy PK and Mole, Joe and Pombo, Guilherme and Gray, Robert J. and Ruffle, James K. and Chan, Edgar and Rees, Geraint E. and Cipolotti, Lisa and Nachev, Parashkev},
  year = 2023,
