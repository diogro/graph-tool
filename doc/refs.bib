  editor = {Arnold, Vladimir I. and Givental, Alexander B. and Khesin, Boris A. and Marsden, Jerrold E. and Varchenko, Alexander N. and Vassiliev, Victor A. and Viro, Oleg Ya. and Zakalyukin, Vladimir M.},
