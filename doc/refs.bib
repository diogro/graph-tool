  langid = {english},
  keywords = {Animal behaviour,Behavioural ecology,Ecological modelling,Information theory and computation,Network topology},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/CMSRMHDB/Ramos-Fernandez et al. - 2026 - Uncovering complementary information sharing in spider monkey collective foraging using higher-order.pdf}
}

