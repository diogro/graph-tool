@article{liu_functional_2018,
  title = {Functional Connectomics from Neural Dynamics: Probabilistic Graphical Models for Neuronal Network of {{Caenorhabditis}} Elegans},
  shorttitle = {Functional Connectomics from Neural Dynamics},
