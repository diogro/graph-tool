@article{aguade-gorgorio_taxonomy_2024,
  title = {A Taxonomy of Multiple Stable States in Complex Ecological Communities},
  author = {{Aguad{\'e}-Gorgori{\'o}}, Guim and Arnoldi, Jean-Fran{\c c}ois and Barbier, Matthieu and K{\'e}fi, Sonia},
  year = 2024,
  journal = {Ecology Letters},
  volume = {27},
  number = {4},
  pages = {e14413},
  issn = {1461-0248},
  doi = {10.1111/ele.14413},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ele.14413},
  urldate = {2025-02-17},
  abstract = {Natural systems are built from multiple interconnected units, making their dynamics, functioning and fragility notoriously hard to predict. A fragility scenario of particular relevance concerns so-called regime shifts: abrupt transitions from healthy to degraded ecosystem states. An explanation for these shifts is that they arise as transitions between alternative stable states, a process that is well-understood in few-species models. However, how multistability upscales with system complexity remains a debated question. Here, we identify that four different multistability regimes generically emerge in models of species-rich communities and other archetypical complex biological systems assuming random interactions. Across the studied models, each regime consistently emerges under a specific interaction scheme and leaves a distinct set of fingerprints in terms of the number of observed states, their species richness and their response to perturbations. Our results help clarify the conditions and types of multistability that can be expected to occur in complex ecological communities.},
  copyright = {\copyright{} 2024 The Authors. Ecology Letters published by John Wiley \& Sons Ltd.},
  langid = {english},
  keywords = {community ecology,complex systems,multiple stable states,regime shifts},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/5DA9R6JV/Aguadé-Gorgorió et al. - 2024 - A taxonomy of multiple stable states in complex ecological communities.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/6JE3YF5Y/ele.html}
}

@misc{aguirre-lopez_heterogeneous_2024,
  title = {Heterogeneous Mean-Field Analysis of the Generalized {{Lotka-Volterra}} Model on a Network},
  author = {{Aguirre-L{\'o}pez}, Fabi{\'a}n},
  year = 2024,
  month = apr,
  number = {arXiv:2404.11164},
  eprint = {2404.11164},
  primaryclass = {cond-mat},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2404.11164},
  url = {http://arxiv.org/abs/2404.11164},
  urldate = {2025-02-17},
  abstract = {We study the dynamics of the generalized Lotka-Volterra model with a network structure. Performing a high connectivity expansion for graphs, we write down a mean-field dynamical theory that incorporates degree heterogeneity. This allows us to describe the fixed points of the model in terms of a few simple order parameters. We extend the analysis even for diverging abundances, using a mapping to the replicator model. With this we present a unified approach for both cooperative and competitive systems that display complementary behaviors. In particular we show the central role of an order parameter called the critical degree, \$g\_c\$. In the competitive regime \$g\_c\$ serves to distinguish high degree nodes that are more likely to go extinct, while in the cooperative regime it has the reverse role, it will determine the low degree nodes that tend to go relatively extinct.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Disordered Systems and Neural Networks},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/8CQYUED6/Aguirre-López - 2024 - Heterogeneous mean-field analysis of the generalized Lotka-Volterra model on a network.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/GTRHN33J/2404.html}
}

@article{agutter_analytic_2011,
  title = {Analytic Theories of Allometric Scaling},
  author = {Agutter, Paul S. and Tuszynski, Jack A.},
  year = 2011,
  month = jan,
  journal = {The Journal of Experimental Biology},
  volume = {214},
  number = {7},
  pages = {1055--1062},
  issn = {0022-0949, 1477-9145},
  doi = {10.1242/jeb.054502},
  url = {http://jeb.biologists.org/content/214/7/1055},
  urldate = {2012-06-28},
  abstract = {During the 13 years since it was first advanced, the fractal network theory (FNT), an analytic theory of allometric scaling, has been subjected to a wide range of methodological, mathematical and empirical criticisms, not all of which have been answered satisfactorily. FNT presumes a two-variable power-law relationship between metabolic rate and body mass. This assumption has been widely accepted in the past, but a growing body of evidence during the past quarter century has raised questions about its general validity. There is now a need for alternative theories of metabolic scaling that are consistent with empirical observations over a broad range of biological applications. In this article, we briefly review the limitations of FNT, examine the evidence that the two-variable power-law assumption is invalid, and outline alternative perspectives. In particular, we discuss quantum metabolism (QM), an analytic theory based on molecular--cellular processes. QM predicts the large variations in scaling exponent that are found empirically and also predicts the temperature dependence of the proportionality constant, issues that have eluded models such as FNT that are based on macroscopic and network properties of organisms.},
  langid = {english},
  keywords = {allometric cascade model,fractal network theory,metabolic limit boundaries hypothesis,quantum metabolism,two-variable power law},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/J2K8KBVV/Agutter and Tuszynski - 2011 - Analytic theories of allometric scaling.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/PNFV8EB8/1055.html}
}

