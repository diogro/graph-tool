@article{hu_emergent_2022,
  title = {Emergent Phases of Ecological Diversity and Dynamics Mapped in Microcosms},
  author = {Hu, Jiliang and Amor, Daniel R. and Barbier, Matthieu and Bunin, Guy and Gore, Jeff},
  year = 2022,
  month = oct,
  journal = {Science},
  volume = {378},
