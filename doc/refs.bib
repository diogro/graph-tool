  keywords = {Bayesian estimation,Compositional data,Correlation,count normalization,Differential abundance,high-throughput sequencing,microbiota,Relative abundance},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/YHK8QF57/Gloor et al. - 2017 - Microbiome Datasets Are Compositional And This Is.pdf}
}

