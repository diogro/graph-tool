@article{cantwell_thresholding_2020,
  title = {Thresholding Normally Distributed Data Creates Complex Networks},
  author = {Cantwell, George T. and Liu, Yanchen and Maier, Benjamin F. and Schwarze, Alice C. and Serv{\'a}n, Carlos A. and Snyder, Jordan and {St-Onge}, Guillaume},
