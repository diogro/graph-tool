@article{st-onge_universal_2021,
  title = {Universal {{Nonlinear Infection Kernel}} from {{Heterogeneous Exposure}} on {{Higher-Order Networks}}},
  author = {{St-Onge}, Guillaume and Sun, Hanlin and Allard, Antoine and {H{\'e}bert-Dufresne}, Laurent and Bianconi, Ginestra},
