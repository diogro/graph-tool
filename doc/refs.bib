  urldate = {2009-11-29},
  abstract = {The dynamic stability of the Boolean networks representing a model for the gene transcriptional regulation (Kauffman model) is studied by calculating analytically and numerically the Hamming distance between two evolving configurations. This turns out to behave in a universal way close to the phase boundary only for in-degree distributions with a finite second moment. In-degree distributions of the form Pd(k) [?] k[?]g with 2 {$<$} g {$<$} 3, thus having a diverging second moment, lead to a slower increase of the Hamming distance when moving towards the unstable phase and to a broadening of the phase boundary for finite N with decreasing g. We conclude that the heterogeneous regulatory network connectivity facilitates the balancing between robustness and evolvability in living organisms.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/8IQ43GIT/Lee and Rieger - 2008 - Broad edge of chaos in strongly heterogeneous Bool.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/S6CDEATD/415001.html}
