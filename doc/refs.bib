@article{perez-reche_prediction_2012,
  title = {Prediction of Invasion from the Early Stage of an Epidemic},
  author = {{P{\'e}rez-Reche}, Francisco J. and Neri, Franco M. and Taraskin, Sergei N. and Gilligan, Christopher A.},
  year = 2012,
