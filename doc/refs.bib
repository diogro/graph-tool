@article{chen_percolation_2007,
  title = {Percolation Theory Applied to Measures of Fragmentation in Social Networks},
  author = {Chen, Yiping and Paul, Gerald and Cohen, Reuven and Havlin, Shlomo and Borgatti, Stephen P. and Liljeros, Fredrik and Stanley, H. Eugene},
