@article{huang_robustness_2011,
  title = {Robustness of Interdependent Networks under Targeted Attack},
  author = {Huang, Xuqing and Gao, Jianxi and Buldyrev, Sergey V. and Havlin, Shlomo and Stanley, H. Eugene},
