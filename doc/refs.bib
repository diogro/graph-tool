  urldate = {2012-11-04},
  abstract = {The possibility of the occurence of a phase transition in an infinite simple random-cluster model (0{$\leq$}p{$\leq$}1,k{$\geq$}1), which includes the percolation model and the ferromagnetic Ising and Ashkin-Teller-Potts model, is studied by means of several criteria for large-range connectivity. It is shown that graphs which contain the square lattice exhibit a phase transition in this sense. The large-range connectivities in the simple random-cluster model turn out to have the same properties as those in the percolation model. Furthermore, it is shown that in graphs with a lattice structure the generalized spontaneous magnetization is strongly related to global large-range connectivity.},
