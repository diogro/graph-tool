  urldate = {2024-07-16},
  abstract = {We present a well-structured detailed exposition of a well-known proof of the following celebrated result solving Hilbert's 13th problem on superpositions. For functions of 2 variables the statement is as follows. Kolmogorov Theorem. There are continuous functions \$\textbackslash varphi\_1,\textbackslash ldots,\textbackslash varphi\_5 : [\textbackslash,0, 1\textbackslash,]\textbackslash to [\textbackslash,0,1\textbackslash,]\$ such that for any continuous function \$f: [\textbackslash,0,1\textbackslash,]\textasciicircum 2\textbackslash to\textbackslash mathbb R\$ there is a continuous function \$h: [\textbackslash,0,3\textbackslash,]\textbackslash to\textbackslash mathbb R\$ such that for any \$x,y\textbackslash in [\textbackslash,0, 1\textbackslash,]\$ we have \$\$f(x,y)=\textbackslash sum\textbackslash limits\_\textbraceleft k=1\textbraceright\textasciicircum 5 h\textbackslash left(\textbackslash varphi\_k(x)+\textbackslash sqrt\textbraceleft 2\textbraceright\textbackslash,\textbackslash varphi\_k(y)\textbackslash right).\$\$ The proof is accessible to non-specialists, in particular, to students familiar with only basic properties of continuous functions.},
  archiveprefix = {arXiv},
  keywords = {26-02 26B40 41A29,Computer Science - Machine Learning,Mathematics - Functional Analysis},
