@article{lopez_transitions_2020,
  title = {Transitions in Loopy Random Graphs with Fixed Degrees and Arbitrary Degree Distributions},
  author = {Lopez, Fabian Aguirre and Coolen, Anthony CC},
  year = 2020,
  month = aug,
  journal = {arXiv:2008.11002 [cond-mat]},
  eprint = {2008.11002},
  primaryclass = {cond-mat},
  url = {http://arxiv.org/abs/2008.11002},
  urldate = {2020-12-30},
  abstract = {We analyze maximum entropy random graph ensembles with constrained degrees, drawn from arbitrary degree distributions, and a tuneable number of 3-loops (triangles). We find that such ensembles generally exhibit two transitions, a clustering and a shattering transition, separating three distinct regimes. At the clustering transition, the graphs change from typically having only isolated loops to forming loop clusters. At the shattering transition the graphs break up into extensively many small cliques to achieve the desired loop density. The locations of both transitions depend nontrivially on the system size. We derive a general formula for the loop density in the regime of isolated loops, for graphs with degree distributions that have finite and second moments. For bounded degree distributions we present further analytical results on loop densities and phase transition locations, which, while non-rigorous, are all validated via MCMC sampling simulations. We show that the shattering transition is of an entropic nature, occurring for all loop density values, provided the system is large enough.},
  archiveprefix = {arXiv},
  keywords = {Condensed Matter - Disordered Systems and Neural Networks},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/HP64ULQS/Lopez und Coolen - 2020 - Transitions in loopy random graphs with fixed degr.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/7IR9K37J/2008.html}
}

@article{lopez-suarez_sub-kbt_2016,
