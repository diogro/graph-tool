@techreport{floretta_stochastic_2013,
  type = {{{arXiv}} E-Print},
  title = {Stochastic Fluctuations and the Detectability Limit of Network Communities},
  author = {Floretta, Lucio and Liechti, Jonas and Flammini, Alessandro and Rios, Paolo De Los},
  year = 2013,
  month = jun,
  number = {1306.2230},
  url = {http://arxiv.org/abs/1306.2230},
  urldate = {2013-06-15},
  abstract = {We have analyzed the detectability limits of network communities in the framework of the popular Girvan and Newman benchmark. By carefully taking into account the inevitable stochastic fluctuations that affect the construction of each and every instance of the benchmark, we come to the conclusions that the native, putative partition of the network is completely lost even before the in-degree/out-degree ratio becomes equal to the one of a structure-less Erd\textbackslash "os-R\textbackslash 'enyi network. We develop a simple iterative scheme, analytically well described by an infinite branching-process, to provide an estimate of the true detectability limit. Using various algorithms based on modularity optimization, we show that all of them behave (semi-quantitatively) in the same way, with the same functional form of the detectability threshold as a function of the network parameters. Because the same behavior has also been found by further modularity-optimization methods and for methods based on different heuristics implementations, we conclude that indeed a correct definition of the detectability limit must take into account the stochastic fluctuations of the network construction.},
  lccn = {0000},
  keywords = {Computer Science - Social and Information Networks,Condensed Matter - Statistical Mechanics,Physics - Physics and Society,Quantitative Biology - Quantitative Methods},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/UJ7PGVRW/Floretta et al. - 2013 - Stochastic fluctuations and the detectability limi.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/PMXUTKQQ/1306.html}
}

