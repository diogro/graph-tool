@inproceedings{wang_algebraic_2008,
  title = {Algebraic Connectivity Optimization via Link Addition},
  booktitle = {Proceedings of the 3rd {{International Conference}} on {{Bio-Inspired Models}} of {{Network}}, {{Information}} and {{Computing Sytems}}},
  author = {Wang, Huijuan and Van Mieghem, Piet},
  year = 2008,
