@article{arikan_channel_2009,
  title = {Channel {{Polarization}}: {{A Method}} for {{Constructing Capacity-Achieving Codes}} for {{Symmetric Binary-Input Memoryless Channels}}},
  shorttitle = {Channel {{Polarization}}},
  author = {Arikan, Erdal},
  year = 2009,
  month = jul,
  journal = {IEEE Transactions on Information Theory},
  volume = {55},
  number = {7},
  pages = {3051--3073},
  issn = {1557-9654},
  doi = {10.1109/TIT.2009.2021379},
  url = {https://ieeexplore.ieee.org/document/5075875},
  urldate = {2026-09-30},
  abstract = {A method is proposed, called channel polarization, to construct code sequences that achieve the symmetric capacity I(W) of any given binary-input discrete memoryless channel (B-DMC) W. The symmetric capacity is the highest rate achievable subject to using the input letters of the channel with equal probability. Channel polarization refers to the fact that it is possible to synthesize, out of N independent copies of a given B-DMC W, a second set of N binary-input channels \textbraceleft W\_N\textasciicircum (i):1\l e i\l e N\textbraceright{} such that, as N becomes large, the fraction of indices i for which I(W\_N\textasciicircum (i)) is near 1 approaches I(W) and the fraction for which I(W\_N\textasciicircum (i)) is near 0 approaches 1-I(W). The polarized channels \textbraceleft W\_N\textasciicircum (i)\textbraceright{} are well-conditioned for channel coding: one need only send data at rate 1 through those with capacity near 1 and at rate 0 through the remaining. Codes constructed on the basis of this idea are called polar codes. The paper proves that, given any B-DMC W with I(W){$>$} 0 and any target rate R {$\ll$} I(W), there exists a sequence of polar codes \textbraceleft\textbackslash Fraktur C\_n;n\textbackslash ge 1\textbraceright{} such that \textbackslash Fraktur C\_n has block-length N=2\textasciicircum n , rate \textbackslash ge R, and probability of block error under successive cancellation decoding bounded as P\_e(N,R) \l e O(N\textasciicircum -1\o ver 4) independently of the code rate. This performance is achievable by encoders and decoders with complexity O(N\l og N) for each.},
  keywords = {Capacity planning,Capacity-achieving codes,channel capacity,Channel capacity,Channel coding,channel polarization,Codes,Councils,Decoding,Information theory,Memoryless systems,Noise cancellation,Plotkin construction,polar codes,Polarization,Reed- Muller (RM) codes,successive cancellation decoding},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/UZSIVB6H/Arikan - 2009 - Channel Polarization A Method for Constructing Capacity-Achieving Codes for Symmetric Binary-Input.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/3QM99HYR/5075875.html}
}

