  year = 2012,
  month = apr,
  journal = {Physical Review E},
  volume = {85},
  number = {4},
  pages = {046103},
  doi = {10.1103/PhysRevE.85.046103},
  url = {http://link.aps.org/doi/10.1103/PhysRevE.85.046103},
  urldate = {2012-05-30},
  abstract = {Randomizing networks using a naive ``accept-all'' edge-swap algorithm is generally biased. Building on recent results for nondirected graphs, we construct an ergodic detailed balance Markov chain with nontrivial acceptance probabilities for directed graphs, which converges to a strictly uniform measure and is based on edge swaps that conserve all in and out degrees. The acceptance probabilities can also be generalized to define Markov chains that target any alternative desired measure on the space of directed graphs in order to generate graphs with more sophisticated topological features. This is demonstrated by defining a process tailored to the production of directed graphs with specified degree-degree correlation functions. The theory is implemented numerically and tested on synthetic and biological network examples.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/2PQB88XB/Roberts and Coolen - 2012 - Unbiased degree-preserving randomization of direct.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/5ZSVF4QG/e046103.html}
}

@article{roberts_use_2005,
  title = {Use the Information Dimension, Not the {{Hausdorff}}},
  author = {Roberts, A. J.},
  year = 2005,
  month = dec,
  journal = {arXiv:nlin/0512014},
  eprint = {nlin/0512014},
  url = {http://arxiv.org/abs/nlin/0512014},
  urldate = {2012-07-01},
  abstract = {Multi-fractal patterns occur widely in nature. In developing new algorithms to determine multi-fractal spectra of experimental data I am lead to the conclusion that generalised dimensions \$D\_q\$ of order \$q\textbackslash leq0\$, including the Hausdorff dimension, are effectively \textbackslash emph\textbraceleft irrelevant\textbraceright. The reason is that these dimensions are extraordinarily sensitive to regions of low density in the multi-fractal data. Instead, one should concentrate attention on generalised dimensions \$D\_q\$ for \$q\textbackslash geq 1\$, and of these the information dimension \$D\_1\$ seems the most robustly estimated from a finite amount of data.},
  archiveprefix = {arXiv},
  keywords = {Nonlinear Sciences - Pattern Formation and Solitons},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/WEGVI5Z3/Roberts - 2005 - Use the information dimension, not the Hausdorff.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/FFN2QR8T/0512014.html}
}

@article{robiglio_higher-order_2025,
  title = {Higher-Order {{Ising}} Model on Hypergraphs},
  author = {Robiglio, Thomas and Di Gaetano, Leonardo and Altieri, Ada and Petri, Giovanni and Battiston, Federico},
  year = 2025,
  month = aug,
  journal = {Physical Review E},
  volume = {112},
  number = {2},
  pages = {L022301},
  publisher = {American Physical Society},
  doi = {10.1103/hbh5-3nty},
  url = {https://link.aps.org/doi/10.1103/hbh5-3nty},
  urldate = {2026-01-26},
  abstract = {Non-dyadic higher-order interactions affect collective behavior in various networked dynamical systems. Here, we discuss the properties of a novel Ising model with higher-order interactions and characterize its phase transitions between the ordered and the disordered phase. By a mean-field treatment, we show that the transition is continuous when only three-body interactions are considered, but becomes abrupt when interactions of higher orders are introduced. Using a Georges-Yedidia expansion to go beyond a na\"ive mean-field approximation, we reveal a quantitative shift in the critical point of the phase transition, which does not affect the universality class of the model. Finally, we compare our results with traditional {$p$}-spin models with many-body interactions. Our work unveils new collective phenomena on complex interacting systems, revealing the importance of investigating higher-order systems beyond three-body interactions.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/IJXIQGNJ/Robiglio et al. - 2025 - Higher-order Ising model on hypergraphs.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/WFGMB57M/hbh5-3nty.html}
}

@misc{robiglio_multiscale_2025,
  title = {Multiscale Patterns of Migration Flows in {{Austria}}: Regionalization, Administrative Barriers, and Urban-Rural Divides},
  shorttitle = {Multiscale Patterns of Migration Flows in {{Austria}}},
  author = {Robiglio, Thomas and Contisciani, Martina and Karsai, M{\'a}rton and Peixoto, Tiago P.},
  year = 2025,
  month = jul,
  number = {arXiv:2507.11503},
  eprint = {2507.11503},
  primaryclass = {physics},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2507.11503},
  url = {http://arxiv.org/abs/2507.11503},
  urldate = {2025-07-22},
  abstract = {Migration is central in various societal problems related to socioeconomic development. While much of the existing research has focused on international migration, migration patterns within a single country remain relatively unexplored. In this work we study internal migration patterns in Austria for a period of over 20 years, obtained from open and high-granularity administrative records. We employ inferential network methods to characterize the flows between municipalities and extract their clustering according to similar target and destination rates. Our methodology reveals significant deviations from commonly assumed relocation patterns modeled by the gravity law. At the same time, we observe unexpected biases of internal migrations that leads to less frequent movements across boundaries at both district and state levels than predictions suggest. This leads to significant regionalization of migration at multiple geographical scales and augmented division between urban and rural areas. These patterns appear to be remarkably persistent across decades of migration data, demonstrating systematic limitations of conventionally used gravity models in migration studies. Our approach presents a robust methodology that can be used to improve such evaluations, and can reveal new phenomena in migration networks.},
  archiveprefix = {arXiv},
  keywords = {Physics - Computational Physics,Physics - Physics and Society,Statistics - Applications,Statistics - Methodology},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/U8C69ZNI/Robiglio et al. - 2025 - Multiscale patterns of migration flows in Austria regionalization, administrative barriers, and urb.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/IERDIVPF/2507.html}
}

@article{robiglio_synergistic_2025,
  title = {Synergistic {{Signatures}} of {{Group Mechanisms}} in {{Higher-Order Systems}}},
  author = {Robiglio, Thomas and Neri, Matteo and Coppes, Davide and Agostinelli, Cosimo and Battiston, Federico and Lucas, Maxime and Petri, Giovanni},
  year = 2025,
  month = mar,
  journal = {Physical Review Letters},
  volume = {134},
  number = {13},
  pages = {137401},
  publisher = {American Physical Society},
  doi = {10.1103/PhysRevLett.134.137401},
  url = {https://link.aps.org/doi/10.1103/PhysRevLett.134.137401},
  urldate = {2026-01-26},
  abstract = {The interplay between causal mechanisms and emerging collective behaviors is a central aspect of understanding, controlling, and predicting complex networked systems. In our work, we investigate the relationship between higher-order mechanisms and higher-order behavioral observables in two representative models with group interactions: a simplicial Ising model and a social contagion model. In both systems, we find that group (higher-order) interactions show emergent synergistic (higher-order) behavior. The emergent synergy appears only at the group level and depends in a complex, nonlinear way on the trade-off between the strengths of the low- and higher-order mechanisms and is invisible to low-order behavioral observables. Our work sets the basis for systematically investigating the relation between causal mechanisms and behavioral patterns in complex networked systems with group interactions, offering a robust methodological framework to tackle this challenging task.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/JUF9WUP5/Robiglio et al. - 2025 - Synergistic Signatures of Group Mechanisms in Higher-Order Systems.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/GAXA5P9N/PhysRevLett.134.html}
}

