@inproceedings{deshpande_asymptotic_2016,
  title = {Asymptotic Mutual Information for the Binary Stochastic Block Model},
  booktitle = {2016 {{IEEE International Symposium}} on {{Information Theory}} ({{ISIT}})},
  author = {Deshpande, Y. and Abbe, E. and Montanari, A.},
  year = 2016,
  month = jul,
  pages = {185--189},
  doi = {10.1109/ISIT.2016.7541286},
  abstract = {We develop an information-theoretic view of the stochastic block model, a popular statistical model for the large-scale structure of complex networks. A graph G from such a model is generated by first assigning vertex labels at random from a finite alphabet, and then connecting vertices with edge probabilities depending on the labels of the endpoints. In the case of the symmetric two-group model, we establish an explicit `single-letter' characterization of the per-vertex mutual information between the vertex labels and the graph, when the graph average degree diverges. The explicit expression of the mutual information is intimately related to estimation-theoretic quantities, and -in particular- reveals a phase transition at the critical point for community detection. Below the critical point the per-vertex mutual information is asymptotically the same as if edges were independent of the vertex labels. Correspondingly, no algorithm can estimate the partition better than random guessing. Conversely, above the threshold, the per-vertex mutual information is strictly smaller than the independent-edges upper bound. In this regime there exists a procedure that estimates the vertex labels better than random guessing.},
  keywords = {asymptotic mutual information,binary stochastic block model,community detection,complex network large-scale structure,complex networks,Computational modeling,edge probability,Entropy,Estimation,graph theory,information theory,information-theoretic view,Mean square error methods,measurement,Mutual information,pervertex mutual information single-letter characterization,Phase transition,probability,statistical analysis,statistical model,Stochastic Processes,symmetric two-group model},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/37IRGSQZ/Deshpande et al. - 2016 - Asymptotic mutual information for the binary stoch.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/R797ET5C/7541286.html}
}

