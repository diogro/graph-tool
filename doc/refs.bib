@article{noel_epidemics_2011,
  title = {Epidemics on Contact Networks: A General Stochastic Approach},
  shorttitle = {Epidemics on Contact Networks},
  author = {No{\"e}l, Pierre-Andr{\'e} and Allard, Antoine and {H{\'e}bert-Dufresne}, Laurent and Marceau, Vincent and Dub{\'e}, Louis J},
  year = 2011,
