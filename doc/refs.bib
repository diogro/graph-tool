@book{attard_non-equilibrium_2012,
  title = {{Non-Equilibrium Thermodynamics and Statistical Mechanics: Foundations and Applications}},
  shorttitle = {{Non-Equilibrium Thermodynamics and Statistical Mechanics}},
  author = {Attard, Phil},
  year = 2012,
  month = oct,
  publisher = {OXFORD UNIV PR},
  address = {Oxford},
  abstract = {`Non-equilibrium Thermodynamics and Statistical Mechanics: Foundations and Applications' builds from basic principles to advanced techniques, and covers the major phenomena, methods, and results of time-dependent systems. It is a pedagogic introduction, a comprehensive reference manual, and an original research monograph. Uniquely, the book treats time-dependent systems by close analogy with their static counterparts, with most of the familiar results of equilibrium thermodynamics and statistical mechanics being generalized and applied to the non-equilibrium case. The book is notable for its unified treatment of thermodynamics, hydrodynamics, stochastic processes, and statistical mechanics, for its self-contained, coherent derivation of a variety of non-equilibrium theorems, and for its quantitative tests against experimental measurements and computer simulations. Systems that evolve in time are more common than static systems, and yet until recently they lacked any over-arching theory. 'Non-equilibrium Thermodynamics and Statistical Mechanics' is unique in its unified presentation of the theory of non-equilibrium systems, which has now reached the stage of quantitative experimental and computational verification. The novel perspective and deep understanding that this book brings offers the opportunity for new direction and growth in the study of time-dependent phenomena. 'Non-equilibrium Thermodynamics and Statistical Mechanics' is an invaluable reference manual for experts already working in the field. Research scientists from different disciplines will find the overview of time-dependent systems stimulating and thought-provoking. Lecturers in physics and chemistry will be excited by many fresh ideas and topics, insightful explanations, and new approaches. Graduate students will benefit from its lucid reasoning and its coherent approach, as well as from the catalogue of mathematical techniques, derivations, and computer algorithms.},
  isbn = {978-0-19-966276-0},
  langid = {Englisch},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/E6MCIK86/Attard - 2012 - Non-Equilibrium Thermodynamics and Statistical Mec.pdf}
}

