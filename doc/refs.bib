@article{agarwala_statistical_1951,
  title = {Statistical Mechanics and Partitions into Non-Integral Powers of Integers},
  author = {Agarwala, B. K. and Auluck, F. C.},
  year = 1951,
  month = jan,
  journal = {Mathematical Proceedings of the Cambridge Philosophical Society},
  volume = {47},
