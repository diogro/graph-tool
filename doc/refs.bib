@article{castellano_thresholds_2010,
  title = {Thresholds for {{Epidemic Spreading}} in {{Networks}}},
  author = {Castellano, Claudio and {Pastor-Satorras}, Romualdo},
  year = 2010,
  month = nov,
  journal = {Physical Review Letters},
  volume = {105},
  number = {21},
  pages = {218701},
  doi = {10.1103/PhysRevLett.105.218701},
  url = {http://link.aps.org/doi/10.1103/PhysRevLett.105.218701},
  urldate = {2013-01-10},
  abstract = {We study the threshold of epidemic models in quenched networks with degree distribution given by a power-law. For the susceptible-infected-susceptible model the activity threshold {$\lambda$}c vanishes in the large size limit on any network whose maximum degree kmax⁡ diverges with the system size, at odds with heterogeneous mean-field (HMF) theory. The vanishing of the threshold has nothing to do with the scale-free nature of the network but stems instead from the largest hub in the system being active for any spreading rate {$\lambda>$}1/\textsurd kmax⁡ and playing the role of a self-sustained source that spreads the infection to the rest of the system. The susceptible-infected-removed model displays instead agreement with HMF theory and a finite threshold for scale-rich networks. We conjecture that on quenched scale-rich networks the threshold of generic epidemic models is vanishing or finite depending on the presence or absence of a steady state.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/652TZIHJ/Castellano and Pastor-Satorras - 2010 - Thresholds for Epidemic Spreading in Networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/FZMTCKW6/Castellano and Pastor-Satorras - 2010 - Thresholds for Epidemic Spreading in Networks.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/IGBPBCPQ/e218701.html;/home/count0/stuff/workspace/pesquisa/zotero/storage/MC7Z4KTS/e218701.html}
}

