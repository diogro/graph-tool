@article{kossinets_empirical_2006,
  title = {Empirical {{Analysis}} of an {{Evolving Social Network}}},
  author = {Kossinets, Gueorgi and Watts, Duncan J.},
  year = 2006,
  month = jan,
  journal = {Science},
  volume = {311},
