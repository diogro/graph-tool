@article{hergarten_earthquake_2003,
  title = {Earthquake Swarms - a Facet of Complexity?},
  author = {Hergarten, S.},
  year = 2003,
  month = apr,
  journal = {EGS - AGU - EUG Joint Assembly, Abstracts from the meeting held in Nice, France, 6 - 11 April 2003, abstract \#3920},
  pages = {3920},
  url = {http://adsabs.harvard.edu/abs/2003EAEJA.....3920H},
  abstract = {There are still open questions concerning the physical and geological background of earthquake swarms. This contribution addresses the question whether it might be possible that the occurrence of earthquake swarms does not reflect certain physical or geological conditions, but is just a facet of complexity. The study is based on the analysis of long time series from the Olami-Feder-Christensen cellular automaton model, which is one of the most widespread models for understanding statistical properties of earthquakes such as the Gutenberg-Richter law and sequences of foreshocks and aftershocks. It has been found that the time spans between medium-sized earthquakes obey a strong variation. As a consequence, few long periods without any large and medium-sized earthquakes occur. During these periods, small earthquakes occur in clusters which look like sequences of foreshocks and aftershocks without mainshocks, so that they may be interpreted in terms of earthquake swarms. Thus, it might be possible that an active fault sometimes experiences a phase where some kinds of earthquake swarms occur instead of large earthquakes, without the need for any special environment. However, further statistical properties of earthquake swarms must be studied in order to find out whether the sequences generated by this simple model can be related to earthquake swarms in reality.}
}

