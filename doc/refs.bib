  year = 2003,
  month = jun,
  journal = {Physical Review E},
  volume = {67},
  number = {6},
  pages = {066106},
  doi = {10.1103/PhysRevE.67.066106},
  url = {http://link.aps.org/doi/10.1103/PhysRevE.67.066106},
  urldate = {2011-03-17},
  abstract = {A geometry of networks endowed with a causal structure is discussed using the conventional framework of the equilibrium statistical mechanics. The popular growing network models appear as particular causal models. We focus on a class of tree graphs, an analytically solvable case. General formulas are derived, describing the degree distribution, the ancestor-descendant correlation, and the probability that a randomly chosen node lives at a given geodesic distance from the root. It is shown that the Hausdorff dimension dH of the causal networks is generically infinite, in contrast to the maximally random trees where it is generically finite.},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/GWSEIQSA/Bialas et al. - 2003 - Tree networks with causal structure.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/WSKGT85G/Bialas et al. - 2003 - Tree networks with causal structure.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/T3W4VICW/e066106.html}
