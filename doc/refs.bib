@article{bottani_self-organized-criticality_1997,
  title = {Self-Organized-Criticality and Synchronization in Pulse Coupled Relaxation Oscillator Systems; the {{Olami}}, {{Feder}} and {{Christense}} and the {{Feder}} and {{Feder}} Model},
  author = {Bottani, Samuele and Delamotte, Bertrand},
  year = 1997,
  month = apr,
  journal = {Physica D: Nonlinear Phenomena},
  volume = {103},
  pages = {430--441},
  url = {http://www.sciencedirect.com/science/article/B6TVK-3SPM8WP-1T/2/858a39634744778086b11196d85a0d27},
  abstract = {We re-examine the dynamics of the Olami, Feder and Christensen (OFC) model. We show that, depending on the dissipation, it exhibits two different behaviors and that it can or cannot show self-organized-criticality (SOC) and/or synchronization. We also show that while the Feder and Feder model perturbed by a stochastic noise is SOC and has the same exponent for the distribution of avalanche sizes as the OFC model, it does not show synchronization. We conclude that a relaxation oscillator system can be synchronized and/or SOC and that synchronization is therefore not necessary for criticality in these models.}
}

