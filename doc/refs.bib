@article{janson_birth_1993,
  title = {The Birth of the Giant Component},
  author = {Janson, Svante and Knuth, Donald E. and {\L}uczak, Tomasz and Pittel, Boris},
  year = 1993,
  month = sep,
  journal = {arXiv:math/9310236},
  eprint = {math/9310236},
  url = {http://arxiv.org/abs/math/9310236},
  urldate = {2014-07-25},
  abstract = {Limiting distributions are derived for the sparse connected components that are present when a random graph on \$n\$ vertices has approximately \$\textbackslash half n\$ edges. In particular, we show that such a graph consists entirely of trees, unicyclic components, and bicyclic components with probability approaching \$\textbackslash sqrt\textbraceleft 2\textbackslash over 3\textbraceright{} \textbackslash cosh\textbackslash sqrt\textbraceleft 5\textbackslash over 18\textbraceright\textbackslash approx0.9325\$ as \$n\textbackslash to\textbackslash infty\$. The limiting probability that it consists of trees, unicyclic components, and at most one other component is approximately 0.9957; the limiting probability that it is planar lies between 0.987 and 0.9998. When a random graph evolves and the number of edges passes \$\textbackslash half n\$, its components grow in cyclic complexity according to an interesting Markov process whose asymptotic structure is derived. The probability that there never is more than a single component with more edges than vertices, throughout the evolution, approaches \$5\textbackslash pi/18\textbackslash approx0.8727\$. A ``uniform'' model of random graphs, which allows self-loops and multiple edges, is shown to lead to formulas that are substantially simpler than the analogous formulas for the classical random graphs of Erd\textbackslash H\textbraceleft o\textbraceright s and R\textbackslash 'enyi. The notions of ``excess'' and ``deficiency,'' which are significant characteristics of the generating function as well as of the graphs themselves, lead to a mathematically attractive structural theory for the uniform model. A general approach to the study of stopping configurations makes it possible to sharpen previously obtained estimates in a uniform manner and often to obtain closed forms for the constants of interest. Empirical results are presented to complement the analysis, indicating the typical behavior when \$n\$ is near 20000.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Combinatorics,Mathematics - Probability},
  file = {/home/count0/stuff/workspace/pesquisa/zotero/storage/P7QKDFF7/Janson et al. - 1993 - The birth of the giant component.pdf;/home/count0/stuff/workspace/pesquisa/zotero/storage/QHAA9WXD/9310236.html}
}

